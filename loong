def hex_to_rgb_tuple(h):
    if not h or not isinstance(h, str):
        return (0, 0, 0)
    h = h.strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if len(h) != 6:
        return (0, 0, 0)
    try:
        return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
    except Exception:
        return (0, 0, 0)

def rgb_to_hex(rgb):
    try:
        r = max(0, min(255, int(rgb[0])))
        g = max(0, min(255, int(rgb[1])))
        b = max(0, min(255, int(rgb[2])))
        return "#{:02x}{:02x}{:02x}".format(r, g, b)
    except Exception:
        return "#000000"

def extract_theme_from_image(path):
    if not _pil_available or not path or not os.path.exists(path):
        return None
    try:
        img = Image.open(path).convert("RGB").resize((180, 180))
        q = img.quantize(colors=12, method=Image.Quantize.MEDIANCUT)
        pal = q.getpalette() or []
        counts = q.getcolors() or []
        counts.sort(key=lambda x: -x[0])
        cand = []
        for count, idx in counts:
            if idx * 3 + 2 >= len(pal):
                continue
            r, g, b = pal[idx * 3], pal[idx * 3 + 1], pal[idx * 3 + 2]
            h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
            cand.append({"rgb": (r, g, b), "count": count, "sat": s, "val": v, "hue": h})
        if not cand:
            return None
        ac = [c for c in cand if c["sat"] > 0.25 and c["val"] > 0.35] or cand
        ac.sort(key=lambda c: -(c["sat"] * 0.7 + c["val"] * 0.3))
        a1 = ac[0]["rgb"]
        a2 = a1
        for c in ac[1:]:
            hd = abs(c["hue"] - ac[0]["hue"])
            if hd > 0.12 or hd > 0.88:
                a2 = c["rgb"]
                break
        def sc(rgb, f):
            return tuple(max(0, min(255, int(v * f))) for v in rgb)
        return {
            "name": "Auto Image",
            "bg": rgb_to_hex(sc(a1, 0.13)),
            "panel": rgb_to_hex(sc(a1, 0.19)),
            "card": rgb_to_hex(sc(a1, 0.26)),
            "card2": rgb_to_hex(sc(a1, 0.33)),
            "border": rgb_to_hex(sc(a1, 0.32)),
            "border2": rgb_to_hex(sc(a1, 0.45)),
            "text": "#f0f0f8",
            "text2": "#a5a5be",
            "text3": "#6a6a88",
            "accent": rgb_to_hex(a1),
            "accent2": rgb_to_hex(a2),
            "glow": "rgba({},{},{},0.5)".format(*a1),
            "gold": "#fbbf24",
            "success": "#34d399",
            "gradient1": rgb_to_hex(a1),
            "gradient2": rgb_to_hex(a2),
        }
    except Exception as e:
        push("Image theme failed: " + str(e))
        return None

