        if (s.streamproof && document.getElementById('setStreamproof'))
            document.getElementById('setStreamproof').checked = true;
        if (s.multi_instance !== undefined && document.getElementById('setMulti'))
            document.getElementById('setMulti').checked = s.multi_instance;
        if (s.hide_topbar_with_window !== undefined && document.getElementById('setHideTopbarWithKey'))
            document.getElementById('setHideTopbarWithKey').checked = s.hide_topbar_with_window;
        if (s.auto_theme_from_image !== undefined && document.getElementById('setAutoThemeImg'))
            document.getElementById('setAutoThemeImg').checked = s.auto_theme_from_image;
        if (s.dev_mode && document.getElementById('setDevMode'))
            document.getElementById('setDevMode').checked = true;
        if (s.performance_mode) {
            document.querySelectorAll('#perfMode button').forEach(b => {
                b.classList.toggle('active', b.dataset.mode === s.performance_mode);
            });
        }
        if (s.toggle_key) {
            toggleKey = s.toggle_key;
            const el = document.getElementById('toggleKeyBtn');
            if (el) el.textContent = toggleKey;
        }
        if (s.roblox_target_version) {
            const sel = document.getElementById('versionSelect');
            if (sel) sel.value = s.roblox_target_version;
        }
    } catch (e) {}

    try {
        const c = await api.get_catalog();
        catalogNames = c.names || [];
    } catch (e) {}

    try {
        const sf = await api.load_saved_flags();
        if (sf && sf.flags && Object.keys(sf.flags).length) {
            flags = sf.flags;
            render();
        } else {
            loadLocal();
        }
    } catch (e) {
        loadLocal();
    }

    const bindToggle = (id, key) => {
        const el = document.getElementById(id);
        if (el) el.onchange = e => api.save_setting(key, e.target.checked);
    };
    bindToggle('setReapply', 'reapplyActive');
    bindToggle('setLiveApply', 'live_apply');
    bindToggle('setDisguise', 'disguise_mode');
    bindToggle('setTray', 'minimize_to_tray');
    bindToggle('setStreamproof', 'streamproof');
    bindToggle('setMulti', 'multi_instance');
    bindToggle('setHideTopbarWithKey', 'hide_topbar_with_window');
    bindToggle('setAutoThemeImg', 'auto_theme_from_image');
    bindToggle('setDevMode', 'dev_mode');

    document.querySelectorAll('#perfMode button').forEach(b => {
        b.onclick = () => {
            document.querySelectorAll('#perfMode button').forEach(x => x.classList.remove('active'));
            b.classList.add('active');
            api.save_setting('performance_mode', b.dataset.mode);
        };
    });
    document.querySelectorAll('#espModel button').forEach(b => {
        b.onclick = () => {
            document.querySelectorAll('#espModel button').forEach(x => x.classList.remove('active'));
            b.classList.add('active');
        };
    });

    const kb = document.getElementById('toggleKeyBtn');
    if (kb) {
        kb.onclick = () => {
            if (bindingKey) return;
            bindingKey = true;
            kb.classList.add('binding');
            kb.textContent = 'Press key...';
            const handler = e => {
                e.preventDefault();
                if (e.key === 'Escape') {
                    kb.textContent = toggleKey;
                    kb.classList.remove('binding');
                    bindingKey = false;
                    document.removeEventListener('keydown', handler);
                    return;
                }
                toggleKey = e.key === ' ' ? 'Space' : e.key;
                kb.textContent = toggleKey;
                kb.classList.remove('binding');
                bindingKey = false;
                document.removeEventListener('keydown', handler);
                api.save_setting('toggle_key', toggleKey);
            };
            document.addEventListener('keydown', handler);
        };
    }

    const fpsUnlockToggle = document.getElementById('fpsUnlockToggle');
    const fpsUnlockState = document.getElementById('fpsUnlockState');
    if (fpsUnlockToggle && fpsUnlockState) {
        fpsUnlockToggle.addEventListener('change', () => {
            fpsUnlockState.textContent = fpsUnlockToggle.checked ? 'Unlocked' : '60 FPS';
            fpsUnlockState.style.color = fpsUnlockToggle.checked ? 'var(--accent2)' : 'var(--text3)';
            toast(fpsUnlockToggle.checked ? 'FPS unlocker enabled — higher load possible' : 'FPS unlocker disabled');
        });
    }

    setInterval(pollInstances, 1800);
    pollInstances();
    setInterval(refreshConsole, 1200);
    refreshConsole();
    loadRobloxVersions();
    setInterval(loadRobloxVersions, 15000);
    
