def load_json_object(p):
    if not p or not os.path.exists(p):
        return {}
    with open(p, "r", encoding="utf-8") as f:
        v = json.load(f)
    if not isinstance(v, dict):
        raise ValueError(p + " must contain object")
    return v

def atomic_write_json(p, v):
    d = os.path.dirname(p)
    os.makedirs(d, exist_ok=True)
    tmp = p + "." + str(os.getpid()) + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(v, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, p)
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except Exception:
                pass

def find_startup_settings_paths(image_path=None):
    c = []
    if image_path:
        vd = os.path.dirname(image_path)
        vdir = os.path.dirname(vd)
        br = os.path.dirname(vdir)
        bn = os.path.basename(br).lower()
        if os.path.basename(vdir).lower() == "versions" and bn in ("froststrap", "bloxstrap"):
            c.append(os.path.join(br, "Modifications", "ClientSettings", "ClientAppSettings.json"))
        else:
            c.append(os.path.join(vd, "ClientSettings", "ClientAppSettings.json"))
    lad = os.environ.get("LOCALAPPDATA")
    if lad:
        for b in ("Froststrap", "Bloxstrap"):
            r = os.path.join(lad, b)
            if os.path.isdir(r):
                c.append(os.path.join(r, "Modifications", "ClientSettings", "ClientAppSettings.json"))
        vroot = os.path.join(lad, "Roblox", "Versions")
        if os.path.isdir(vroot):
            vdirs = []
            for n in os.listdir(vroot):
                d = os.path.join(vroot, n)
                ex = os.path.join(d, "RobloxPlayerBeta.exe")
                if os.path.isfile(ex):
                    vdirs.append((os.path.getmtime(ex), d))
            if vdirs:
                _, d = max(vdirs)
                c.append(os.path.join(d, "ClientSettings", "ClientAppSettings.json"))
    seen = set()
    out = []
    for x in c:
        n = os.path.normcase(os.path.abspath(x))
        if n in seen:
            continue
        seen.add(n)
        pr = os.path.dirname(os.path.dirname(os.path.dirname(x)))
        if os.path.exists(x) or os.path.isdir(pr):
            out.append(os.path.abspath(x))
    return out

def get_screen_size():
    try:
        import tkinter as tk
        r = tk.Tk()
        r.withdraw()
        w = r.winfo_screenwidth()
        h = r.winfo_screenheight()
        r.destroy()
        return (w, h)
    except Exception:
        return (1920, 1080)

def image_data_uri(data):
    if not data:
        return None
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        mime = "image/png"
    elif data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        mime = "image/webp"
    elif data.startswith(b"\xff\xd8\xff"):
        mime = "image/jpeg"
    else:
        mime = "application/octet-stream"
    return "data:" + mime + ";base64," + base64.b64encode(data).decode("ascii")

def path_to_data_uri(p):
    if not p or not os.path.exists(p):
        return None
    try:
        with open(p, "rb") as f:
            return image_data_uri(f.read())
    except Exception:
        return None

def _remove_dwm_border(hwnd):
    try:
        dwm = ctypes.windll.dwmapi
        col = ctypes.c_uint(0xFFFFFFFE)
        dwm.DwmSetWindowAttribute(ctypes.wintypes.HWND(hwnd), 34, ctypes.byref(col), ctypes.sizeof(col))
        pref = ctypes.c_int(1)
        dwm.DwmSetWindowAttribute(ctypes.wintypes.HWND(hwnd), 33, ctypes.byref(pref), ctypes.sizeof(pref))
        pol = ctypes.c_int(1)
        dwm.DwmSetWindowAttribute(ctypes.wintypes.HWND(hwnd), 2, ctypes.byref(pol), ctypes.sizeof(pol))
        class M(ctypes.Structure):
            _fields_ = [("l", ctypes.c_int), ("r", ctypes.c_int),
                        ("t", ctypes.c_int), ("b", ctypes.c_int)]
        m = M(-1, -1, -1, -1)
        dwm.DwmExtendFrameIntoClientArea(ctypes.wintypes.HWND(hwnd), ctypes.byref(m))
    except Exception as e:
        push("DWM: " + str(e))

def _strip_frame(hwnd):
    try:
        u32 = ctypes.windll.user32
        GWL = -16
        u32.GetWindowLongW.restype = ctypes.c_long
        u32.SetWindowLongW.restype = ctypes.c_long
        u32.GetWindowLongW.argtypes = [ctypes.wintypes.HWND, ctypes.c_int]
        u32.SetWindowLongW.argtypes = [ctypes.wintypes.HWND, ctypes.c_int, ctypes.c_long]
        s = u32.GetWindowLongW(ctypes.wintypes.HWND(hwnd), GWL)
        for b in (0x00C00000, 0x00040000, 0x00800000, 0x00400000, 0x00080000, 0x00020000, 0x00010000):
            s &= ~b
        u32.SetWindowLongW(ctypes.wintypes.HWND(hwnd), GWL, s)
    except Exception as e:
        push("strip: " + str(e))

def _apply_colorkey(hwnd, key_hex):
    try:
        u32 = ctypes.windll.user32
        r, g, b = hex_to_rgb_tuple(key_hex)
        cr = (b << 16) | (g << 8) | r
        GWL = -20
        WS_EX_LAYERED = 0x00080000
        LWA_COLORKEY = 0x00000001
        u32.GetWindowLongW.restype = ctypes.c_long
        u32.SetWindowLongW.restype = ctypes.c_long
        u32.GetWindowLongW.argtypes = [ctypes.wintypes.HWND, ctypes.c_int]
        u32.SetWindowLongW.argtypes = [ctypes.wintypes.HWND, ctypes.c_int, ctypes.c_long]
        s = u32.GetWindowLongW(ctypes.wintypes.HWND(hwnd), GWL)
        s |= WS_EX_LAYERED
        u32.SetWindowLongW(ctypes.wintypes.HWND(hwnd), GWL, s)
        u32.SetLayeredWindowAttributes(ctypes.wintypes.HWND(hwnd), cr, 0, LWA_COLORKEY)
        return True
    except Exception as e:
        push("colorkey: " + str(e))
        return False

