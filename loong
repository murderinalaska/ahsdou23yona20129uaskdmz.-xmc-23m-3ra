function getKind(name) {
    const p = [
        ['DFFlag','bool'], ['SFFlag','bool'], ['FFlag','bool'],
        ['DFInt','int'], ['SFInt','int'], ['FInt','int'],
        ['DFLog','log'], ['SFLog','log'], ['FLog','log'],
        ['DFString','string'], ['SFString','string'], ['FString','string'],
    ];
    for (const [pf, k] of p) if (name.startsWith(pf)) return k;
    return '?';
}
function escapeHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function escapeAttr(s) {
    return String(s).replace(/"/g, '&quot;').replace(/&/g, '&amp;');
}
function escapeJs(s) {
    return String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
}

function render() {
    const q = (document.getElementById('flagSearch').value || '').toLowerCase();
    const entries = Object.entries(flags).filter(([k, v]) => {
        if (!q) return true;
        return k.toLowerCase().includes(q) || String(v).toLowerCase().includes(q);
    });
    const list = document.getElementById('flagList');
    if (!list) return;
    list.innerHTML = '';

    const counter = document.getElementById('flagCount');
    if (counter) {
        const total = Object.keys(flags).length;
        counter.textContent = total + ' active';
        counter.classList.add('bump');
        setTimeout(() => counter.classList.remove('bump'), 300);
    }

    if (!entries.length) {
        const msg = Object.keys(flags).length === 0
            ? '<h3>No flags loaded</h3><p>Use the <b>Add Flag</b> panel, or <b>Import</b>.</p>'
            : '<h3>No matches</h3><p>No flags match your search.</p>';
        list.innerHTML =
            '<div class="empty-state">' +
            '<div class="icon-big">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
            '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>' +
            '<polyline points="14 2 14 8 20 8"/></svg>' +
            '</div>' + msg + '</div>';
        return;
    }

    for (const [name, val] of entries) {
        const kind = getKind(name);
        const cls = (kind === 'bool' || kind === 'int' || kind === 'log' || kind === 'string') ? kind : 'unknown';
        const row = document.createElement('div');
        row.className = 'flag-row';
        row.innerHTML =
            '<span class="type-tag ' + cls + '">' + kind + '</span>' +
            '<span class="name" title="' + escapeAttr(name) + '">' + escapeHtml(name) + '</span>' +
            '<input class="value-input" value="' + escapeAttr(val) + '" onchange="updateFlag(\'' + escapeJs(name) + '\', this.value)">' +
            '<button class="remove-btn" onclick="removeFlag(\'' + escapeJs(name) + '\')">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">' +
            '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
        list.appendChild(row);
    }
}

