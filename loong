async function runLoadingSequence() {
    const loading = document.getElementById('loading');
    const bar = document.getElementById('loadBar');
    const status = document.getElementById('loadStatus');

    /*
       V5 startup gate:
       splash -> loading -> license -> post-license loading -> workspace.
       The editor/header/topbar are never revealed during the first two stages.
    */
    const steps = [
        [10, 'Connecting to workspace…'],
        [32, 'Preparing interface…'],
        [55, 'Loading visual systems…'],
        [78, 'Preparing license gate…'],
        [100, 'Ready for activation.']
    ];

    if (loading) {
        loading.style.display = 'flex';
        loading.classList.remove('fade');
        loading.style.opacity = '1';
        loading.style.visibility = 'visible';
        loading.style.pointerEvents = 'auto';
    }

    /* A real ~4 second stage, rather than a near-instant progress flash. */
    for (const [pct, text] of steps) {
        if (bar) bar.style.width = pct + '%';
        if (status) status.textContent = text;
        await sleep(760);
    }

    /*
       IMPORTANT:
       Do NOT call any pywebview API here.

       The previous version tried to probe api.is_licensed() between the
       loading screen and the license screen.  pywebview RPC calls can block
       the browser/UI event loop while the native side is busy.  When that
       happens, even the JavaScript setTimeout used by Promise.race cannot
       fire, so the progress reaches "Ready for activation." and appears
       permanently frozen.

       Startup therefore has one job here: finish the visual loading gate
       and reveal the license screen.  License validation happens only when
       the user presses Activate, where it belongs.
    */

    /* Never allow the editor or topbar to appear at this point. */
    document.getElementById('header').style.display = 'none';
    document.getElementById('workspace').style.display = 'none';
    hideMainTopbar();
    sessionReady = false;
    licensed = false;

    if (loading) {
        loading.classList.add('fade');
        await sleep(650);
        loading.style.display = 'none';
    }

    /* License screen is now the ONLY visible/interactable UI. */
    const keyScreen = document.getElementById('keyscreen');
    if (keyScreen) {
        keyScreen.classList.remove('hide');
        keyScreen.classList.add('show');
        keyScreen.style.display = 'flex';
        keyScreen.style.visibility = 'visible';
        keyScreen.style.opacity = '1';
        keyScreen.style.pointerEvents = 'auto';

        setTimeout(() => {
            const keyInput = document.getElementById('keyInput');
            if (keyInput) {
                keyInput.focus();
                try {
                    keyInput.select();
                } catch (e) {}
            }
        }, 140);
    }
}

function closeLoading() {
    /* Startup loading cannot be skipped; this prevents editor/license races. */
    return;
}

async function submitKey() {
    const input = document.getElementById('keyInput');
    const msg = document.getElementById('keyMsg');
    const key = input.value.trim();
    if (!key) {
        msg.className = 'msg err';
        msg.textContent = 'Enter your license key';
        return;
    }
    const res = await api.check_license(key);
    if (res.ok) {
        licensed = true;
        msg.className = 'msg ok';
        msg.textContent = '✓ License activated';
        await sleep(450);
        await runPostLicenseLoading();
        toast('Welcome to Deadwae');
    } else {
        msg.className = 'msg err';
        msg.textContent = '✗ Invalid license key';
    }
}

