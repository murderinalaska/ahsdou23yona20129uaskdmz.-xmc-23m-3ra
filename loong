async function runPostLicenseLoading() {
    const overlay = document.getElementById('post-license-loading');
    const bar = document.getElementById('plBar');
    const status = document.getElementById('plStatus');
    if (!overlay) return;

    const keyScreen = document.getElementById('keyscreen');
    const header = document.getElementById('header');
    const workspace = document.getElementById('workspace');

    if (keyScreen) {
        keyScreen.style.transition = 'opacity .55s ease, visibility 0s linear .55s';
        keyScreen.style.opacity = '0';
        keyScreen.style.pointerEvents = 'none';
        keyScreen.style.visibility = 'hidden';
    }

    if (header) header.style.display = 'none';
    if (workspace) workspace.style.display = 'none';
    hideMainTopbar();
    sessionReady = false;

    overlay.classList.add('show');
    if (bar) bar.style.width = '0%';

    const steps = [
        [12, 'Verifying license…'],
        [31, 'Loading flag catalog…'],
        [52, 'Applying your theme…'],
        [73, 'Preparing workspace…'],
        [91, 'Starting Deadwae…'],
        [100, 'Ready.']
    ];

    /* ~4.8 seconds: deliberately visible and smooth. */
    for (const [pct, text] of steps) {
        if (bar) bar.style.width = pct + '%';
        if (status) status.textContent = text;
        await sleep(720);
    }

    await sleep(520);

    overlay.classList.add('hide');
    await sleep(420);
    overlay.classList.remove('show', 'hide');

    if (keyScreen) {
        keyScreen.style.transition = '';
        keyScreen.classList.remove('show');
    }

    if (header) {
        header.style.display = 'flex';
        header.classList.remove('ui-reveal');
        void header.offsetWidth;
        header.classList.add('ui-reveal');
    }
    if (workspace) {
        workspace.style.display = 'flex';
        workspace.classList.remove('ui-reveal');
        void workspace.offsetWidth;
        workspace.classList.add('ui-reveal');
    }

    sessionReady = true;
    try { await api.on_loading_done(); } catch (e) {}
    try { await api.refresh_topbar(); } catch (e) {}
    showMainTopbar();
}

