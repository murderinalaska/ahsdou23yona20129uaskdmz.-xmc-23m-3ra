let fpsInterval = null;
function startFpsGraph() {
    if (fpsInterval) return;
    const canvas = document.getElementById('fpsCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const points = [];
    const MAX = 220;
    function resize() {
        const r = canvas.getBoundingClientRect();
        canvas.width = r.width * window.devicePixelRatio;
        canvas.height = r.height * window.devicePixelRatio;
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    resize();
    window.addEventListener('resize', resize);
    function tick() {
        if (!canvas.parentElement) return;
        points.push(60 + (Math.random() * 30 - 15));
        if (points.length > MAX) points.shift();
        const w = canvas.width / window.devicePixelRatio;
        const h = canvas.height / window.devicePixelRatio;
        ctx.clearRect(0, 0, w, h);
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#8b5cf6';
        ctx.strokeStyle = 'rgba(255,255,255,0.04)';
        ctx.lineWidth = 1;
        for (let i = 0; i <= 4; i++) {
            const y = (h / 4) * i;
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(w, y);
            ctx.stroke();
        }
        if (points.length > 1) {
            ctx.strokeStyle = accent;
            ctx.lineWidth = 1.8;
            ctx.shadowColor = accent;
            ctx.shadowBlur = 10;
            ctx.beginPath();
            const step = w / (MAX - 1);
            for (let i = 0; i < points.length; i++) {
                const x = i * step;
                const y = h - (points[i] / 120) * h;
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
            ctx.shadowBlur = 0;
        }
        const avg = points.reduce((a, b) => a + b, 0) / (points.length || 1);
        const el = document.getElementById('avgFps');
        if (el) el.textContent = 'Average FPS: ' + avg.toFixed(2);
    }
    fpsInterval = setInterval(tick, 80);
}

