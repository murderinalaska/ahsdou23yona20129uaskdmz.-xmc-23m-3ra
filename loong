def apply_performance_mode(m):
    try:
        k = ctypes.windll.kernel32
        h = k.GetCurrentProcess()
        if m == "low":
            k.SetPriorityClass(h, 0x00000020)
        elif m == "medium":
            k.SetPriorityClass(h, 0x00008000)
        elif m == "high":
            k.SetPriorityClass(h, 0x00000080)
        return True
    except Exception:
        return False

VK_MAP = {
    "Insert": 0x2D, "Delete": 0x2E, "Home": 0x24, "End": 0x23,
    "PageUp": 0x21, "PageDown": 0x22,
    "F1": 0x70, "F2": 0x71, "F3": 0x72, "F4": 0x73,
    "F5": 0x74, "F6": 0x75, "F7": 0x76, "F8": 0x77,
    "F9": 0x78, "F10": 0x79, "F11": 0x7A, "F12": 0x7B,
    "Tab": 0x09, "CapsLock": 0x14,
}
WM_HOTKEY = 0x0312
WM_QUIT = 0x0012
MOD_NOREPEAT = 0x4000
_HK_ID = 0xDEAD
_hk_thread = None
_hk_stop = threading.Event()

def _vk(name):
    if not name:
        return None
    if name in VK_MAP:
        return VK_MAP[name]
    if len(name) == 1:
        c = name.upper()
        if "A" <= c <= "Z" or "0" <= c <= "9":
            return ord(c)
    return None

def _hk_loop(vk):
    u32 = ctypes.windll.user32
    if not u32.RegisterHotKey(None, _HK_ID, MOD_NOREPEAT, vk):
        push("Hotkey register failed")
        return
    push("Hotkey registered")
    msg = ctypes.wintypes.MSG()
    try:
        while not _hk_stop.is_set():
            r = u32.GetMessageW(ctypes.byref(msg), None, 0, 0)
            if r == 0 or r == -1:
                break
            if msg.message == WM_HOTKEY and msg.wParam == _HK_ID:
                try:
                    toggle_visibility()
                except Exception as e:
                    push("toggle: " + str(e))
            u32.TranslateMessage(ctypes.byref(msg))
            u32.DispatchMessageW(ctypes.byref(msg))
    finally:
        u32.UnregisterHotKey(None, _HK_ID)
        push("Hotkey unregistered")

def start_hotkey(name):
    global _hk_thread
    stop_hotkey()
    vk = _vk(name)
    if vk is None:
        return False
    _hk_stop.clear()
    _hk_thread = threading.Thread(target=_hk_loop, args=(vk,), daemon=True)
    _hk_thread.start()
    return True

def stop_hotkey():
    global _hk_thread
    if _hk_thread and _hk_thread.is_alive():
        _hk_stop.set()
        try:
            ctypes.windll.user32.PostThreadMessageW(_hk_thread.ident, WM_QUIT, 0, 0)
        except Exception:
            pass
        _hk_thread.join(timeout=1.5)
    _hk_thread = None
    _hk_stop.clear()

def _repair_json(t):
    if not t:
        return t
    t = t.lstrip("\ufeff")
    t = re.sub(r"(?<!:)//[^\n\r]*", "", t)
    t = re.sub(r"/\*.*?\*/", "", t, flags=re.DOTALL)
    t = re.sub(r",\s*([}\]])", r"\1", t)
    t = re.sub(r"}\s*\{", "},{", t)
    t = re.sub(r'}\s*"', '},"', t)
    t = re.sub(r'"(\s*)\n(\s*)"', r'",\n"', t)
    t = re.sub(r",\s*,", ",", t)
    return t

def _lenient_json(t):
    if not t:
        return None
    try:
        return json.loads(t)
    except Exception as e:
        push("strict json: " + str(e))
    try:
        return json.loads(_repair_json(t))
    except Exception as e:
        push("repaired json: " + str(e))
    r = {}
    for m in re.finditer(
        r'"([A-Za-z][A-Za-z0-9_:]*)"\s*:\s*("(?:[^"\\]|\\.)*"|true|false|null|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)',
        t
    ):
        n = m.group(1)
        v = m.group(2)
        if v.startswith('"') and v.endswith('"'):
            v = v[1:-1]
        if n and not n.startswith("_"):
            r[n] = v
    if r:
        push("regex extraction: " + str(len(r)))
        return r
    r2 = {}
    for m in re.finditer(
        r'"name"\s*:\s*"([^"]+)"\s*,\s*"value"\s*:\s*("(?:[^"\\]|\\.)*"|true|false|null|-?\d+(?:\.\d+)?)',
        t
    ):
        n = m.group(1)
        v = m.group(2)
        if v.startswith('"') and v.endswith('"'):
            v = v[1:-1]
        r2[n] = v
    if r2:
        push("array regex: " + str(len(r2)))
        return r2
    return None

def _coerce_catalog(p):
    r = {}
    if p is None:
        return r
    if isinstance(p, dict):
        if len(p) == 1 and "flags" in p and isinstance(p["flags"], (dict, list)):
            return _coerce_catalog(p["flags"])
        for k, v in p.items():
            try:
                r[str(k)] = json.dumps(v) if isinstance(v, (dict, list)) else str(v)
            except Exception:
                continue
        return r
    if isinstance(p, list):
        for it in p:
            if isinstance(it, dict):
                if "name" in it and "value" in it:
                    r[str(it["name"])] = str(it["value"])
                elif "name" in it:
                    r[str(it["name"])] = "true"
                elif len(it) == 1:
                    k, v = next(iter(it.items()))
                    r[str(k)] = str(v)
            elif isinstance(it, str):
                r[it] = "true"
        return r
    return r

class Catalog:
    def __init__(self, log_cb=None):
        self._log = log_cb or print
        self.backend = {}
        self.memory = {}
        self._lock = threading.RLock()
        self._load()

    def _load(self):
        try:
            if os.path.exists(CATALOG_CACHE_FILE):
                with open(CATALOG_CACHE_FILE, "r", encoding="utf-8") as f:
                    d = json.load(f)
                self.backend = d.get("backend", {}) or {}
                self.memory = d.get("memory", {}) or {}
                self._log("Catalog cache: " + str(len(self.backend)) + " / " + str(len(self.memory)))
        except Exception as e:
            self._log("Catalog cache: " + str(e))

    def _save(self):
        try:
            with open(CATALOG_CACHE_FILE, "w", encoding="utf-8") as f:
                json.dump({
                    "backend": self.backend,
                    "memory": self.memory,
                    "ts": datetime.now().isoformat(),
                }, f)
        except Exception:
            pass

    def _fetch(self, url, label):
        try:
            self._log("Fetch (" + label + "): " + url)
            r = requests.get(
                url,
                timeout=HTTP_TIMEOUT,
                headers={"User-Agent": APP_NAME + "/" + APP_VERSION}
            )
            self._log("Status (" + label + "): " + str(r.status_code))
            r.raise_for_status()
            txt = r.text or ""
            self._log("Size (" + label + "): " + str(len(txt)))
            raw = _lenient_json(txt)
            if raw is None:
                self._log("Parse fail (" + label + ")")
                return {}
            parsed = _coerce_catalog(raw)
            self._log("OK (" + label + "): " + str(len(parsed)))
            return parsed
        except Exception as e:
            self._log("Fetch err (" + label + "): " + str(e))
        return {}

    def sync(self):
        b = self._fetch(CATALOG_BACKEND_URL, "backend")
        m = self._fetch(CATALOG_MEMORY_URL, "memory")
        with self._lock:
            if b:
                self.backend = b
            if m:
                self.memory = m
        self._save()
        with self._lock:
            tot = len(set(self.backend) | set(self.memory))
        self._log("Merged: " + str(tot))
        return True

    def all_names(self):
        with self._lock:
            return sorted(set(self.backend) | set(self.memory))

    def default_value(self, n):
        with self._lock:
            if n in self.backend:
                return self.backend[n]
            if n in self.memory:
                return self.memory[n]
        return None

    def search(self, q, limit=100):
        q = (q or "").strip().lower()
        if not q:
            return self.all_names()[:limit]
        out = []
        with self._lock:
            for n in set(self.backend) | set(self.memory):
                if q in n.lower():
                    out.append(n)
                    if len(out) >= limit:
                        break
        return sorted(out)

class OffsetManager:
    def __init__(self, log_cb=None):
        self._log = log_cb or print
        self.offsets = {}
        self.external_offsets = {}
        self.source_version = None
        self.external_source_version = None
        self.last_update = None
        self._lock = threading.RLock()
        self.load_from_cache()

    def load_from_cache(self):
        try:
            if os.path.exists(OFFSET_CACHE_FILE):
                with open(OFFSET_CACHE_FILE, "r", encoding="utf-8") as f:
                    d = json.load(f)
                with self._lock:
                    self.offsets = {str(n): int(o) for n, o in (d.get("offsets") or {}).items()}
                    self.external_offsets = {str(n): int(o) for n, o in (d.get("external_offsets") or {}).items()}
                    self.source_version = d.get("source_version")
                    self.external_source_version = d.get("external_source_version")
                self.last_update = datetime.fromisoformat(d.get("last_update", "2000-01-01"))
                self._log("Offsets cache: " + str(len(self.offsets)))
                return True
        except Exception as e:
            self._log("Cache: " + str(e))
        return False

    def save_to_cache(self):
        try:
            now = datetime.now()
            with self._lock:
                d = {
                    "schema": CACHE_SCHEMA_VERSION,
                    "offsets": self.offsets,
                    "external_offsets": self.external_offsets,
                    "source_version": self.source_version,
                    "external_source_version": self.external_source_version,
                    "sources": OFFSET_SOURCES,
                    "last_update": now.isoformat(),
                }
            with open(OFFSET_CACHE_FILE, "w", encoding="utf-8") as f:
                json.dump(d, f, separators=(",", ":"))
            self.last_update = now
        except Exception as e:
            self._log("Save cache: " + str(e))

    def is_cache_fresh(self):
        if not self.last_update:
            return False
        return datetime.now() - self.last_update < timedelta(hours=CACHE_DURATION_HOURS)

    @staticmethod
    def _extract_ns(c, ns):
        m = re.search(r"\bnamespace\s+" + re.escape(ns) + r"\s*\{", c)
        if not m:
            return None
        ob = c.find("{", m.start())
        d = 0
        for i in range(ob, len(c)):
            ch = c[i]
            if ch == "{":
                d += 1
            elif ch == "}":
                d -= 1
                if d == 0:
                    return c[ob + 1:i]
        return None

    @staticmethod
    def _parse_const(c):
        return {
            n: int(o, 16)
            for n, o in re.findall(
                r"\b(?:std::)?uintptr_t\s+(\w+)\s*=\s*(0x[0-9A-Fa-f]+)\s*;",
                c
            )
        }

    @staticmethod
    def _parse_ns_const(c):
        o = {}
        stack = []
        ns_p = re.compile(r"^\s*namespace\s+(\w+)\s*\{")
        c_p = re.compile(r"\b(?:std::)?uintptr_t\s+(\w+)\s*=\s*(0x[0-9A-Fa-f]+)\s*;")
        for line in c.splitlines():
            m = ns_p.search(line)
            if m:
                stack.append(m.group(1))
                continue
            m = c_p.search(line)
            if m:
                n, v = m.groups()
                o["::".join(stack + [n])] = int(v, 16)
            if re.match(r"^\s*}\s*;?\s*$", line) and stack:
                stack.pop()
        return o

    @classmethod
    def _parse_fflags(cls, c):
        sec = cls._extract_ns(c, "FFlags")
        if sec is None:
            return {}, None
        offs = cls._parse_const(sec)
        vm = re.search(r'\bClientVersion\s*=\s*"([^"]+)"', c)
        return offs, (vm.group(1) if vm else None)

    @staticmethod
    def _parse_cv(c):
        m = re.search(r'\bClientVersion\s*=\s*"([^"]+)"', c)
        return m.group(1) if m else None

    def load_offsets_from_content(self, c):
        offs, v = self._parse_fflags(c)
        if not offs:
            self._log("No FFlags ns")
            return False
        with self._lock:
            self.offsets = offs
            self.source_version = v
        self.save_to_cache()
        self._log("Loaded " + str(len(offs)))
        return True

    def sync_from_sources(self):
        dl = {}
        h = {"User-Agent": APP_NAME + "/" + APP_VERSION}
        for name, url in OFFSET_SOURCES.items():
            try:
                r = requests.get(url, timeout=HTTP_TIMEOUT, headers=h)
                r.raise_for_status()
                dl[name] = r.text
            except Exception as e:
                self._log("Fetch " + name + ": " + str(e))
        offs, v = self._parse_fflags(dl.get("fflags", ""))
        if not offs:
            self._log("FFlag parse fail")
            return False
        ext = self._parse_ns_const(dl.get("external", ""))
        ev = self._parse_cv(dl.get("external", ""))
        if v and ev and v != ev:
            ext = {}
        with self._lock:
            self.offsets = offs
            if ext:
                self.external_offsets = ext
                self.external_source_version = ev
            self.source_version = v
        self.save_to_cache()
        self._log("Synced " + str(len(offs)))
        return True

    def get_offset(self, n):
        c = clean_flag_name(n)
        with self._lock:
            return self.offsets.get(c)

    def get_all_offsets(self):
        with self._lock:
            return dict(self.offsets)

    def is_compatible_with(self, cv):
        with self._lock:
            return not cv or not self.source_version or cv == self.source_version

class OffsetInjector:
    def __init__(self, om, log_cb=None):
        self.k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        self.k32.WriteProcessMemory.argtypes = [
            ctypes.wintypes.HANDLE,
            ctypes.c_void_p,
            ctypes.c_void_p,
            ctypes.c_size_t,
            ctypes.POINTER(ctypes.c_size_t)
        ]
        self.k32.WriteProcessMemory.restype = ctypes.wintypes.BOOL
        self.pid = 0
        self.h_process = None
        self.pm = None
        self.base = 0
        self.client_version = None
        self._log = log_cb or print
        self.offset_manager = om
        self.default_values = {}
        self.injected_flags_cache = {}
        self.last_error = ""

    def attach_with_handle(self, pid, pm, base, cv=None):
        try:
            self.pid = pid
            self.pm = pm
            self.base = base
            self.client_version = cv
            self.h_process = pm.process_handle
            self._log("Attached PID " + str(pid))
            return True
        except Exception as e:
            self.last_error = "Attach: " + str(e)
            return False

    def _write(self, addr, data):
        if not self.h_process:
            self.last_error = "No process"
            return False
        buf = ctypes.create_string_buffer(data, len(data))
        w = ctypes.c_size_t(0)
        ok = self.k32.WriteProcessMemory(
            self.h_process, ctypes.c_void_p(addr), buf, len(data), ctypes.byref(w)
        )
        if not ok or w.value != len(data):
            self.last_error = "Write failed @0x" + format(addr, "X")
            return False
        return True

    def _read(self, addr, size):
        return bytes(self.pm.read_bytes(addr, size))

    @staticmethod
    def _parse_bool(v):
        n = str(v).strip().lower()
        if n in ("true", "1", "yes", "on"):
            return 1
        if n in ("false", "0", "no", "off"):
            return 0
        raise ValueError("bad bool")

    def _read_str(self, addr):
        raw = self._read(addr, 32)
        sz = int.from_bytes(raw[16:24], "little")
        cap = int.from_bytes(raw[24:32], "little")
        if sz > cap or cap > 16 * 1024 * 1024:
            raise ValueError("bad string")
        if cap < 16:
            data = raw[:sz]
        else:
            p = int.from_bytes(raw[:8], "little")
            if not p:
                raise ValueError("null")
            data = self._read(p, sz)
        return data.decode("utf-8")

    def _write_str(self, addr, v):
        e = str(v).encode()
        raw = self._read(addr, 32)
        os_ = int.from_bytes(raw[16:24], "little")
        cap = int.from_bytes(raw[24:32], "little")
        if os_ > cap or cap > 16 * 1024 * 1024:
            self.last_error = "bad string"
            return False
        if len(e) > cap:
            self.last_error = "too long"
            return False
        if cap < 16:
            t = addr
        else:
            t = int.from_bytes(raw[:8], "little")
            if not t:
                self.last_error = "null buf"
                return False
        if not self._write(t, e + b"\x00"):
            return False
        return self._write(addr + 16, len(e).to_bytes(8, "little"))

    def _addr(self, name):
        if not self.offset_manager.is_compatible_with(self.client_version):
            self.last_error = "ver mismatch"
            return None
        o = self.offset_manager.get_offset(name)
        if o is None:
            self.last_error = "no offset"
            return None
        return self.base + o

    def set_flag(self, name, value):
        self.last_error = ""
        a = self._addr(name)
        if a is None:
            return False
        vs = str(value).strip()
        ft = get_flag_type(name)
        if ft is None:
            self.last_error = "no prefix"
            return False
        try:
            if ft in ("FFlag", "DFFlag", "SFFlag"):
                data = bytes((self._parse_bool(vs),))
            elif ft in ("FInt", "DFInt", "SFInt"):
                p = int(vs, 10)
                if not -(2 ** 31) <= p < 2 ** 31:
                    raise ValueError("range")
                data = p.to_bytes(4, "little", signed=True)
            elif ft in ("FLog", "DFLog", "SFLog"):
                p = int(vs, 10)
                if not 0 <= p <= 255:
                    raise ValueError("log range")
                data = bytes((p,))
            elif ft in ("FString", "DFString", "SFString"):
                r = self._write_str(a, vs)
                if r:
                    self.injected_flags_cache[name] = vs
                return r
            else:
                self.last_error = "unsupported"
                return False
            r = self._write(a, data)
            if r:
                self.injected_flags_cache[name] = vs
            return r
        except Exception as e:
            self.last_error = str(e)
            return False

    def verify_flag(self, name, expected):
        a = self._addr(name)
        if a is None:
            return False
        ft = get_flag_type(name)
        try:
            if ft in ("FFlag", "DFFlag", "SFFlag"):
                return self._read(a, 1)[0] == self._parse_bool(expected)
            elif ft in ("FInt", "DFInt", "SFInt"):
                return int.from_bytes(self._read(a, 4), "little", signed=True) == int(expected)
            elif ft in ("FLog", "DFLog", "SFLog"):
                return self._read(a, 1)[0] == int(expected)
            elif ft in ("FString", "DFString", "SFString"):
                return self._read_str(a) == str(expected).strip()
            return False
        except Exception as e:
            self.last_error = str(e)
            return False

    def get_flag(self, name):
        a = self._addr(name)
        if a is None:
            return None
        try:
            ft = get_flag_type(name)
            if ft in ("FFlag", "DFFlag", "SFFlag"):
                return "True" if self._read(a, 1)[0] else "False"
            elif ft in ("FInt", "DFInt", "SFInt"):
                return str(int.from_bytes(self._read(a, 4), "little", signed=True))
            elif ft in ("FLog", "DFLog", "SFLog"):
                return str(self._read(a, 1)[0])
            elif ft in ("FString", "DFString", "SFString"):
                return self._read_str(a)
            return None
        except Exception as e:
            self.last_error = str(e)
            return None

    def store_default_value(self, name):
        if name in self.default_values:
            return True
        try:
            v = self.get_flag(name)
            if v is not None:
                self.default_values[name] = v
                return True
        except Exception as e:
            self.last_error = str(e)
        return False

    def restore_to_default(self, flags):
        s = 0
        f = 0
        for flag in flags:
            try:
                n = flag["name"]
                if n in self.default_values:
                    if self.set_flag(n, self.default_values[n]):
                        s += 1
                    else:
                        f += 1
            except Exception:
                f += 1
        if f == 0:
            self.default_values.clear()
            self.injected_flags_cache.clear()
        return s, f

    def revert_all_defaults(self):
        s = 0
        f = 0
        snapshot = dict(self.default_values)
        for n, orig in snapshot.items():
            try:
                if self.set_flag(n, orig):
                    s += 1
                else:
                    f += 1
            except Exception:
                f += 1
        self.default_values.clear()
        self.injected_flags_cache.clear()
        return s, f

class FFlagMonitor:
    def __init__(self, injector, log_cb=None):
        self.injector = injector
        self._log = log_cb or print
        self.flag_states = {}
        self.monitoring = False
        self.monitor_thread = None
        self._stop = threading.Event()
        self.interval = 5.0
        self.total_reinjected = 0
        self._lock = threading.Lock()

    def start_monitoring(self):
        if self.monitoring:
            return
        self.monitoring = True
        self._stop.clear()
        self.monitor_thread = threading.Thread(target=self._loop, daemon=True)
        self.monitor_thread.start()

    def stop_monitoring(self):
        self.monitoring = False
        self._stop.set()
        t = self.monitor_thread
        if t and t.is_alive() and t is not threading.current_thread():
            t.join(timeout=1.0)
        self.monitor_thread = None

    def update_injected_flags(self, flags):
        with self._lock:
            self.flag_states.clear()
            for f in flags:
                self.flag_states[f["name"]] = {
                    "desired": f["value"],
                    "last": time.time(),
                    "count": 1,
                }

    def clear_injected_flags(self):
        with self._lock:
            self.flag_states.clear()
            self.total_reinjected = 0

    def get_total_reinjected(self):
        with self._lock:
            return self.total_reinjected

    def _loop(self):
        if self._stop.wait(2):
            return
        while self.monitoring:
            try:
                if not self.flag_states or not self.injector.h_process:
                    if self._stop.wait(1):
                        return
                    continue
                self._check()
                if self._stop.wait(self.interval):
                    return
            except Exception:
                if self._stop.wait(5):
                    return

    def _check(self):
        to_fix = []
        with self._lock:
            for n, s in list(self.flag_states.items()):
                try:
                    if not self.injector.verify_flag(n, s["desired"]):
                        to_fix.append(n)
                except Exception:
                    continue
        for n in to_fix:
            try:
                s = self.flag_states.get(n)
                if not s:
                    continue
                if self.injector.set_flag(n, s["desired"]):
                    with self._lock:
                        self.flag_states[n]["last"] = time.time()
                        self.flag_states[n]["count"] += 1
                        self.total_reinjected += 1
            except Exception:
                continue

class HybridInjector:
    def __init__(self, log_cb=None):
        self._log = log_cb or print
        self.connected_processes = {}
        self.active_pid = None
        self.offset_injector = None
        self.monitor = None
        self.monitoring_enabled = bool(load_settings().get("reapplyActive", True))
        self.live_apply_enabled = bool(load_settings().get("live_apply", True))
        self.saved_flags = []
        self._waiting_message_shown = False
        self._is_injecting = False
        self._apply_lock = threading.RLock()
        self._state_lock = threading.RLock()
        self.startup_settings_path = None
        self.catalog = Catalog(log_cb)
        self.saved_flags = load_saved_flags()
        if self.saved_flags:
            self._log("Loaded " + str(len(self.saved_flags)) + " saved flags")
        self.offset_manager = OffsetManager(log_cb)
        if not self.offset_manager.is_cache_fresh():
            self.offset_manager.sync_from_sources()
        threading.Thread(target=self._monitor_roblox, daemon=True).start()

    def sync_offsets(self):
        return self.offset_manager.sync_from_sources()

    def upload_offsets(self, c):
        return self.offset_manager.load_offsets_from_content(c)

    @staticmethod
    def _valid_startup_target(p):
        if not isinstance(p, str):
            return False
        a = os.path.abspath(p)
        parts = [x.lower() for x in os.path.normpath(a).split(os.sep)]
        return os.path.basename(a).lower() == "clientappsettings.json" and "clientsettings" in parts

    def _resolve_paths(self):
        with self._state_lock:
            ip = [
                t.get("image_path") or get_process_image_path(pid)
                for pid, t in self.connected_processes.items()
            ]
        if not ip:
            ip = [None]
        tg = []
        seen = set()
        for i in ip:
            for t in find_startup_settings_paths(i):
                if not self._valid_startup_target(t):
                    continue
                n = os.path.normcase(os.path.abspath(t))
                if n in seen:
                    continue
                seen.add(n)
                tg.append(os.path.abspath(t))
        self.startup_settings_path = tg[0] if tg else None
        return tg

    def _load_manifest(self):
        try:
            return load_json_object(STARTUP_MANIFEST_FILE)
        except Exception:
            return {}

    def _restore_manifest(self, m):
        te = m.get("targets")
        if not isinstance(te, dict):
            l = m.get("target")
            te = {l: m} if l else {}
        r = 0
        rt = []
        errs = []
        for t, e in te.items():
            if not self._valid_startup_target(t) or not isinstance(e, dict):
                continue
            orig = e.get("originals", {})
            managed = e.get("managed_names", list(orig))
            if not orig:
                continue
            try:
                s = load_json_object(t)
                tr = 0
                for n in managed:
                    b = orig.get(n)
                    if not isinstance(b, dict):
                        continue
                    if b.get("existed"):
                        s[n] = b.get("value")
                    else:
                        s.pop(n, None)
                    tr += 1
                atomic_write_json(t, s)
                r += tr
                rt.append(t)
            except Exception as e2:
                errs.append(t + ": " + str(e2))
        return {
            "restored": r,
            "targets": rt,
            "target": rt[0] if rt else None,
            "error": "; ".join(errs) if errs else None,
        }

    def persist_startup_flags(self, flags):
        flags = normalize_flags(flags)
        tg = self._resolve_paths()
        if not tg:
            return {
                "persisted": 0,
                "target": None,
                "targets": [],
                "target_count": 0,
                "error": "No ClientAppSettings.json",
            }
        m = self._load_manifest()
        prev = m.get("targets")
        if not isinstance(prev, dict):
            l = m.get("target")
            prev = {l: m} if l else {}
        nv = flags_as_dict(flags)
        nn = set(nv)
        ue = {}
        st = []
        errs = []
        for t in tg:
            try:
                s = load_json_object(t)
                e = prev.get(t, {})
                orig = dict(e.get("originals", {})) if isinstance(e, dict) else {}
                pn = set(e.get("managed_names", orig.keys())) if isinstance(e, dict) else set()
                for n in pn - nn:
                    b = orig.pop(n, None)
                    if not isinstance(b, dict):
                        continue
                    if b.get("existed"):
                        s[n] = b.get("value")
                    else:
                        s.pop(n, None)
                for n, v in nv.items():
                    if n not in orig:
                        orig[n] = {"existed": n in s, "value": s.get(n)}
                    s[n] = v
                atomic_write_json(t, s)
                ue[t] = {"managed_names": sorted(nn), "originals": orig}
                st.append(t)
            except Exception as ex:
                errs.append(t + ": " + str(ex))
        atomic_write_json(STARTUP_MANIFEST_FILE, {
            "schema": 2,
            "targets": ue,
            "last_update": datetime.now().isoformat(),
        })
        return {
            "persisted": len(flags) if st else 0,
            "target": st[0] if st else None,
            "targets": st,
            "target_count": len(st),
            "error": "; ".join(errs) if errs else None,
        }

    def remove_startup_flags(self):
        m = self._load_manifest()
        r = self._restore_manifest(m)
        if r["error"]:
            return r
        try:
            atomic_write_json(STARTUP_MANIFEST_FILE, {})
        except Exception as e:
            r["error"] = str(e)
        return r

    def _monitor_roblox(self):
        while True:
            try:
                cp = set(find_roblox_processes())
                with self._state_lock:
                    kp = set(self.connected_processes)
                for pid in kp - cp:
                    with self._state_lock:
                        t = self.connected_processes.pop(pid, None)
                    if t:
                        t["monitor"].stop_monitoring()
                        try:
                            t["pm"].close_process()
                        except Exception:
                            pass
                        self._log("PID " + str(pid) + " closed")
                for pid in sorted(cp - kp):
                    try:
                        self._log("New PID " + str(pid))
                        pm = pymem.Pymem(pid)
                        base = get_module_base(pid)
                        if not base:
                            raise RuntimeError("no base")
                        cv = get_roblox_client_version(pid)
                        if not self.offset_manager.is_compatible_with(cv):
                            self.offset_manager.sync_from_sources()
                        inj = OffsetInjector(self.offset_manager, log_cb=self._log)
                        if not inj.attach_with_handle(pid, pm, base, cv):
                            raise RuntimeError(inj.last_error)
                        mon = FFlagMonitor(inj, log_cb=self._log)
                        title = get_window_title_for_pid(pid) or ""
                        t = {
                            "pm": pm,
                            "base": base,
                            "injector": inj,
                            "monitor": mon,
                            "version": cv,
                            "image_path": get_process_image_path(pid),
                            "title": title,
                        }
                        with self._state_lock:
                            self.connected_processes[pid] = t
                        if self.monitoring_enabled:
                            mon.start_monitoring()
                        self.saved_flags = load_saved_flags()
                        if self.saved_flags and not self._is_injecting:
                            self._is_injecting = True
                            try:
                                self._log("Reapply to PID " + str(pid))
                                self._apply_offset(
                                    self.saved_flags,
                                    silent=True,
                                    process_injector=inj,
                                    process_monitor=mon,
                                    pid=pid
                                )
                            finally:
                                self._is_injecting = False
                    except Exception as e:
                        self._log("Attach fail " + str(pid) + ": " + str(e))
                        with self._state_lock:
                            self.connected_processes.pop(pid, None)
                with self._state_lock:
                    if self.connected_processes:
                        self.active_pid = max(self.connected_processes)
                        a = self.connected_processes[self.active_pid]
                        self.offset_injector = a["injector"]
                        self.monitor = a["monitor"]
                    else:
                        self.active_pid = None
                        self.offset_injector = None
                        self.monitor = None
                        self._is_injecting = False
                if not cp and not self._waiting_message_shown:
                    self._log("Waiting for Roblox...")
                    self._waiting_message_shown = True
                elif cp and self._waiting_message_shown:
                    self._waiting_message_shown = False
            except Exception as e:
                self._log("Monitor: " + str(e))
            time.sleep(2)

    def list_instances(self):
        with self._state_lock:
            tg = list(self.connected_processes.items())
        out = []
        for pid, t in tg:
            inj = t.get("injector")
            out.append({
                "pid": pid,
                "version": t.get("version") or "",
                "title": t.get("title") or "",
                "flags_cached": len(inj.injected_flags_cache) if inj else 0,
            })
        return out

    def uninject_current(self):
        st = self.remove_startup_flags()
        with self._state_lock:
            tg = list(self.connected_processes.items())
        if not tg:
            self.saved_flags = []
            save_flags_to_file([])
            return {
                "success": 0,
                "fail": 0,
                "startup_restored": st["restored"],
                "message": "Removed " + str(st["restored"]) + " startup",
            }
        if self.saved_flags:
            r = 0
            f = 0
            for _, t in tg:
                t["monitor"].stop_monitoring()
                t["monitor"].clear_injected_flags()
                rr, ff = t["injector"].restore_to_default(self.saved_flags)
                r += rr
                f += ff
            self.saved_flags = []
            save_flags_to_file([])
            return {
                "success": r,
                "fail": f,
                "startup_restored": st["restored"],
                "message": "Restored " + str(r),
            }
        return {
            "success": 0,
            "fail": 0,
            "startup_restored": st["restored"],
            "message": "Removed startup",
        }

    def revert_all(self):
        with self._apply_lock:
            with self._state_lock:
                tg = list(self.connected_processes.items())
            ts = 0
            tf = 0
            for pid, t in tg:
                t["monitor"].stop_monitoring()
                t["monitor"].clear_injected_flags()
                s, f = t["injector"].revert_all_defaults()
                ts += s
                tf += f
                self._log("Reverted " + str(s) + "/" + str(s + f) + " PID " + str(pid))
            st = self.remove_startup_flags()
            self.saved_flags = []
            save_flags_to_file([])
            return {
                "success": ts,
                "fail": tf,
                "startup_restored": st.get("restored", 0),
                "instances": len(tg),
            }

    def apply_flags(self, flags, live=None, target_pid=None):
        rf = normalize_flags(flags)
        if not rf:
            return {"success": 0, "fail": 0, "queued": False, "message": "No flags", "failures": []}
        flags = []
        invalid = []
        for f in rf:
            on = f["name"]
            cn = FLAG_ALIASES.get(on, on)
            if cn != on:
                self._log("Alias " + on + " -> " + cn)
            cf = {"name": cn, "value": f["value"]}
            if self.offset_manager.get_offset(cn) is None:
                invalid.append({"name": on, "reason": "not in fflags.hpp"})
            else:
                flags.append(cf)
        rt = len(rf)
        rec = len(flags)
        if invalid:
            self._log("Rejected " + str(len(invalid)))
        st = self.persist_startup_flags(flags)
        with self._state_lock:
            tg = list(self.connected_processes.items())
        if target_pid is not None:
            tg = [(pid, t) for pid, t in tg if pid == target_pid]
        if not tg:
            self.saved_flags = flags
            save_flags_to_file(flags)
            return {
                "success": 0,
                "fail": len(invalid),
                "queued": True,
                "persisted": st["persisted"],
                "startup_path": st["target"],
                "startup_paths": st.get("targets", []),
                "startup_target_count": st.get("target_count", 0),
                "startup_error": st["error"],
                "message": "Saved " + str(st["persisted"]) + "/" + str(rt) + " for startup",
                "failures": invalid,
            }
        lf = self.live_apply_enabled if live is None else bool(live)
        with self._apply_lock:
            prs = []
            for pid, t in tg:
                inj = t["injector"]
                mon = t["monitor"]
                mon.stop_monitoring()
                mon.clear_injected_flags()
                if self.saved_flags and inj.default_values and not lf:
                    inj.restore_to_default(self.saved_flags)
                prs.append(self._apply_offset(
                    flags, silent=False, process_injector=inj, process_monitor=mon, pid=pid
                ))
            sc = {f["name"]: 0 for f in flags}
            fd = {f["name"]: [] for f in flags}
            vw = 0
            for pr in prs:
                vw += pr["success"]
                for n in pr["succeeded_names"]:
                    sc[n] += 1
                for f in pr["failures"]:
                    fd[f["name"]].append("PID " + str(f.get("pid")) + ": " + f["reason"])
            fv = {n for n, c in sc.items() if c == len(tg)}
            fl = invalid + [
                {"name": n, "reason": "; ".join(fd[n]) or "not verified"}
                for n in sc if n not in fv
            ]
            res = {
                "success": len(fv),
                "fail": rt - len(fv),
                "queued": False,
                "failures": fl,
                "verified_writes": vw,
                "process_count": len(tg),
                "recognized": rec,
                "live": lf,
            }
            self.saved_flags = flags
            save_flags_to_file(flags)
            res["persisted"] = st["persisted"]
            res["startup_path"] = st["target"]
            res["startup_paths"] = st.get("targets", [])
            res["startup_target_count"] = st.get("target_count", 0)
            res["startup_error"] = st["error"]
            res["message"] = (
                "Verified " + str(res["success"]) + "/" + str(rt)
                + " in " + str(len(tg)) + " instance(s)"
                + (" (live)" if lf else "")
            )
            return res

    def _apply_offset(self, flags, silent=False, process_injector=None,
                      process_monitor=None, pid=None):
        inj = process_injector or self.offset_injector
        mon = process_monitor or self.monitor
        ok = 0
        fail = 0
        injected = []
        failed = []
        for f in flags:
            n = f["name"]
            v = f["value"]
            if not inj.store_default_value(n):
                fail += 1
                failed.append({"name": n, "pid": pid, "reason": inj.last_error or "no original"})
                continue
            if inj.set_flag(n, v) and inj.verify_flag(n, v):
                ok += 1
                injected.append(f)
            else:
                fail += 1
                failed.append({"name": n, "pid": pid, "reason": inj.last_error or "verify fail"})
                orig = inj.default_values.get(n)
                if orig is not None:
                    inj.set_flag(n, orig)
        if not silent:
            label = "PID " + str(pid) + ": " if pid is not None else ""
            self._log(label + "verified " + str(ok) + "/" + str(ok + fail))
        if mon and self.monitoring_enabled and ok > 0:
            mon.update_injected_flags(injected)
            if not mon.monitoring:
                mon.start_monitoring()
        return {
            "success": ok,
            "fail": fail,
            "queued": False,
            "failures": failed,
            "succeeded_names": [f["name"] for f in injected],
        }

    def set_monitoring(self, e):
        e = bool(e)
        self.monitoring_enabled = e
        with self._state_lock:
            ms = [t["monitor"] for t in self.connected_processes.values()]
        for m in ms:
            if e:
                m.start_monitoring()
            else:
                m.stop_monitoring()
        return e

    def get_reinjected_count(self):
        with self._state_lock:
            ms = [t["monitor"] for t in self.connected_processes.values()]
        return sum(m.get_total_reinjected() for m in ms)

    def is_attached(self):
        with self._state_lock:
            return bool(self.connected_processes)

class Presets:
    def __init__(self):
        self._lock = threading.RLock()
        self._data = {}
        try:
            if os.path.exists(PRESETS_FILE):
                with open(PRESETS_FILE, "r", encoding="utf-8") as f:
                    self._data = json.load(f)
                if not isinstance(self._data, dict):
                    self._data = {}
        except Exception as e:
            push("Presets load: " + str(e))
            self._data = {}

    def _save(self):
        try:
            atomic_write_json(PRESETS_FILE, self._data)
            return True
        except Exception as e:
            push("Presets save: " + str(e))
            return False

    def list(self):
        with self._lock:
            return sorted(self._data.keys())

    def get(self, n):
        with self._lock:
            return self._data.get(n)

    def save(self, n, flags):
        if not n or not isinstance(flags, dict):
            return False, "invalid"
        try:
            with self._lock:
                self._data[n] = flags
                if not self._save():
                    return False, "write failed"
            return True, None
        except Exception as e:
            return False, str(e)

    def delete(self, n):
        with self._lock:
            if n in self._data:
                del self._data[n]
                self._save()
                return True
        return False

    def merge_into_current(self, n, cur):
        with self._lock:
            p = self._data.get(n)
            if p is None:
                return None
            m = dict(cur)
            for k, v in p.items():
                m[k] = v
            return m

    def merge_current_into(self, n, cur):
        with self._lock:
            p = self._data.get(n)
            if p is None:
                return None
            m = dict(p)
            for k, v in cur.items():
                m[k] = v
            self._data[n] = m
            self._save()
            return m

