def detect_flag_type(n, v=None):
    n = str(n).strip()
    for p in FFLAG_PREFIXES:
        if n.startswith(p):
            return p
    if v is not None:
        vl = str(v).strip().lower()
        if vl in ("true", "false", "1", "0", "yes", "no", "on", "off"):
            return "FFlag"
        try:
            int(vl, 10)
            return "FInt"
        except Exception:
            return "FString"
    return "FFlag"

def normalize_flags(value):
    if isinstance(value, dict) and "flags" in value:
        value = value["flags"]
    out = []
    if isinstance(value, dict):
        items = value.items()
    elif isinstance(value, list):
        items = []
        for it in value:
            if isinstance(it, dict) and "name" in it and "value" in it:
                items.append((it["name"], it["value"]))
            elif isinstance(it, dict) and len(it) == 1:
                items.append(next(iter(it.items())))
            else:
                raise ValueError("Invalid flag entry: " + repr(it))
    else:
        raise ValueError("Flags must be a JSON object or list")
    seen = set()
    for n, v in items:
        n = str(n).strip()
        if not n:
            raise ValueError("Flag names cannot be empty")
        if n in seen:
            continue
        seen.add(n)
        out.append({"name": n, "value": str(v)})
    return out

def flags_as_dict(flags):
    return {i["name"]: i["value"] for i in normalize_flags(flags)}

def _try_parse_json(t):
    if not t:
        return None
    try:
        return json.loads(t)
    except Exception:
        pass
    fixed = re.sub(r",\s*([}\]])", r"\1", t)
    try:
        return json.loads(fixed)
    except Exception:
        pass
    return None

def _try_parse_base64(t):
    if not t:
        return None
    c = "".join(t.split())
    if len(c) < 20 or not re.match(r"^[A-Za-z0-9+/=_-]+$", c):
        return None
    try:
        padded = c + "=" * (-len(c) % 4)
        d = base64.b64decode(padded, validate=False).decode("utf-8", "ignore")
        return d if d.strip() else None
    except Exception:
        return None

def _try_parse_lines(t):
    out = {}
    if not t:
        return out
    for raw in t.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or line.startswith("//"):
            continue
        m = re.match(r'^"?([A-Za-z][A-Za-z0-9_:]+)"?\s*[:=]\s*(.+?),?$', line)
        if m:
            n = m.group(1).strip()
            v = m.group(2).strip().rstrip(",")
            if v.startswith('"') and v.endswith('"'):
                v = v[1:-1]
            if n and v:
                out[n] = v
            continue
        parts = line.split(None, 1)
        if len(parts) == 2:
            n = parts[0].strip().strip('"\'').strip()
            v = parts[1].strip().strip('"\'')
            if n and v:
                out[n] = v
    return out

def parse_multi_flag_input(t):
    if not t or not t.strip():
        return {}, "empty"
    b64 = _try_parse_base64(t.strip())
    if b64:
        inner = _try_parse_json(b64)
        if inner is not None:
            flat = _coerce_flag_dict(inner)
            if flat:
                return flat, "base64 → json"
        inner_lines = _try_parse_lines(b64)
        if inner_lines:
            return inner_lines, "base64 → lines"
    p = _try_parse_json(t)
    if p is not None:
        flat = _coerce_flag_dict(p)
        if flat:
            return flat, "json"
    lines = _try_parse_lines(t)
    if lines:
        return lines, "lines"
    return {}, "unknown"

def _coerce_flag_dict(p):
    r = {}
    if p is None:
        return r
    if isinstance(p, dict):
        if "flags" in p and isinstance(p["flags"], (dict, list)):
            return _coerce_flag_dict(p["flags"])
        for k, v in p.items():
            if isinstance(v, (dict, list)):
                continue
            r[str(k)] = str(v)
        return r
    if isinstance(p, list):
        for it in p:
            if isinstance(it, dict):
                if "name" in it and "value" in it:
                    r[str(it["name"])] = str(it["value"])
                elif len(it) == 1:
                    k, v = next(iter(it.items()))
                    r[str(k)] = str(v)
        return r
    return r

