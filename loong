async function refreshInstanceDropdown() {
    try {
        const res = await api.list_instances();
        const insts = res.instances || [];
        const dd = document.getElementById('instance-dropdown');
        dd.innerHTML = '';
        const all = document.createElement('div');
        all.className = 'inst-item' + (selectedInstancePid === null ? ' active' : '');
        all.innerHTML =
            '<span class="ind"></span>' +
            '<div class="info"><div class="n1">All Instances</div>' +
            '<div class="n2">' + insts.length + ' attached</div></div>' +
            '<span class="badge">ALL</span>';
        all.onclick = () => { selectInstance(null); dd.classList.remove('open'); };
        dd.appendChild(all);
        for (const inst of insts) {
            const item = document.createElement('div');
            item.className = 'inst-item' + (selectedInstancePid === inst.pid ? ' active' : '');
            item.innerHTML =
                '<span class="ind"></span>' +
                '<div class="info">' +
                '<div class="n1">PID ' + inst.pid + '</div>' +
                '<div class="n2">' + escapeHtml((inst.version || 'unknown') + (inst.title ? ' · ' + inst.title : '')) + '</div>' +
