function loadCustomIntoInputs(data) {
    if (!data) return;
    const map = {
        bg: 'colBg', panel: 'colPanel', card: 'colCard', border: 'colBorder',
        text: 'colText', accent: 'colAccent', accent2: 'colAccent2'
    };
    for (const k in map) {
        if (data[k]) {
            const el = document.getElementById(map[k]);
            const txt = document.getElementById(map[k] + 'Txt');
            if (el) el.value = data[k];
            if (txt) txt.value = data[k].toUpperCase();
        }
    }
    if (data.accent) {
        const g = document.getElementById('colGlow');
        const gt = document.getElementById('colGlowTxt');
        if (g) g.value = data.accent;
        if (gt) gt.value = data.accent.toUpperCase();
    }
}
function bindColorInputs() {
    const pairs = [
        ['colBg','colBgTxt'], ['colPanel','colPanelTxt'],
        ['colCard','colCardTxt'], ['colBorder','colBorderTxt'],
        ['colText','colTextTxt'], ['colAccent','colAccentTxt'],
        ['colAccent2','colAccent2Txt'], ['colGlow','colGlowTxt']
    ];
    pairs.forEach(([a, b]) => {
        const cEl = document.getElementById(a);
        const tEl = document.getElementById(b);
        if (!cEl || !tEl) return;
        cEl.oninput = () => { tEl.value = cEl.value.toUpperCase(); previewCustom(); };
        tEl.oninput = () => {
            let v = tEl.value.trim();
            if (!v.startsWith('#')) v = '#' + v;
            if (/^#[0-9a-fA-F]{6}$/.test(v)) { cEl.value = v.toLowerCase(); previewCustom(); }
        };
    });
}
function previewCustom() { applyThemeData(gatherCustom()); }
function gatherCustom() {
    const base = Object.assign({}, THEME_DATA.deadwae);
    const map = {
        bg: 'colBg', panel: 'colPanel', card: 'colCard', border: 'colBorder',
        text: 'colText', accent: 'colAccent', accent2: 'colAccent2'
    };
    for (const k in map) {
        const el = document.getElementById(map[k]);
        if (el) base[k] = el.value;
    }
    const gEl = document.getElementById('colGlow');
    const g = gEl ? gEl.value : base.accent;
    base.glow = hexToRgba(g, 0.5);
    base.gradient1 = base.accent;
    base.gradient2 = base.accent2 || base.accent;
    base.card2 = base.card;
    base.border2 = base.border;
    base.text2 = base.text;
    base.text3 = base.text;
    base.success = '#34d399';
    base.gold = '#fbbf24';
    return base;
}
