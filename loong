def get_module_base(pid):
    k32 = ctypes.WinDLL("kernel32", use_last_error=True)
    psapi = ctypes.WinDLL("psapi", use_last_error=True)
    k32.OpenProcess.argtypes = [ctypes.wintypes.DWORD, ctypes.wintypes.BOOL, ctypes.wintypes.DWORD]
    k32.OpenProcess.restype = ctypes.wintypes.HANDLE
    k32.CloseHandle.argtypes = [ctypes.wintypes.HANDLE]
    psapi.EnumProcessModules.argtypes = [
        ctypes.wintypes.HANDLE,
        ctypes.POINTER(ctypes.c_void_p),
        ctypes.wintypes.DWORD,
        ctypes.POINTER(ctypes.wintypes.DWORD)
    ]
    h = k32.OpenProcess(1040, False, pid)
    if not h:
        return None
    mods = (ctypes.c_void_p * 1024)()
    cb = ctypes.wintypes.DWORD()
    if psapi.EnumProcessModules(h, mods, ctypes.sizeof(mods), ctypes.byref(cb)):
        if cb.value >= ctypes.sizeof(ctypes.c_void_p):
            k32.CloseHandle(h)
            return int(mods[0])
    k32.CloseHandle(h)
    return None

def get_process_image_path(pid):
    k32 = ctypes.WinDLL("kernel32", use_last_error=True)
    k32.OpenProcess.argtypes = [ctypes.wintypes.DWORD, ctypes.wintypes.BOOL, ctypes.wintypes.DWORD]
    k32.OpenProcess.restype = ctypes.wintypes.HANDLE
    k32.QueryFullProcessImageNameW.argtypes = [
        ctypes.wintypes.HANDLE,
        ctypes.wintypes.DWORD,
        ctypes.wintypes.LPWSTR,
        ctypes.POINTER(ctypes.wintypes.DWORD)
    ]
    h = k32.OpenProcess(0x1000, False, pid)
    if not h:
        return None
    try:
        sz = ctypes.wintypes.DWORD(32768)
        buf = ctypes.create_unicode_buffer(sz.value)
        if k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(sz)):
            return buf.value
    finally:
        k32.CloseHandle(h)
    return None

def get_roblox_client_version(pid):
    p = get_process_image_path(pid)
    if not p:
        return None
    v = os.path.basename(os.path.dirname(p))
    return v if v.lower().startswith("version-") else None

def get_window_title_for_pid(pid):
    try:
        u32 = ctypes.windll.user32
        titles = []
        WNDENUMPROC = ctypes.WINFUNCTYPE(
            ctypes.wintypes.BOOL,
            ctypes.wintypes.HWND,
            ctypes.wintypes.LPARAM
        )
        def cb(hwnd, _):
            try:
                wpid = ctypes.wintypes.DWORD()
                u32.GetWindowThreadProcessId(hwnd, ctypes.byref(wpid))
                if wpid.value == pid:
                    l = u32.GetWindowTextLengthW(hwnd)
                    if l > 0:
                        b = ctypes.create_unicode_buffer(l + 1)
                        u32.GetWindowTextW(hwnd, b, l + 1)
                        if b.value.strip():
                            titles.append(b.value.strip())
            except Exception:
                pass
            return True
        u32.EnumWindows(WNDENUMPROC(cb), 0)
        return titles[0] if titles else None
    except Exception:
        return None

def list_installed_roblox_versions():
    out = []
    lad = os.environ.get("LOCALAPPDATA")
    if not lad:
        return out
    root = os.path.join(lad, "Roblox", "Versions")
    if not os.path.isdir(root):
        return out
    try:
        for n in os.listdir(root):
            d = os.path.join(root, n)
            if not os.path.isdir(d) or not n.lower().startswith("version-"):
                continue
            ex = os.path.join(d, "RobloxPlayerBeta.exe")
            if not os.path.isfile(ex):
                continue
            try:
                mt = os.path.getmtime(ex)
            except Exception:
                mt = 0
            out.append({"name": n, "path": d, "exe": ex, "modified": mt})
    except Exception as e:
        push("list versions: " + str(e))
    out.sort(key=lambda r: -r["modified"])
    return out

