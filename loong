    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}
.console-wrap .head .title {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text2);
    letter-spacing: 0.4px;
    text-transform: uppercase;
}
.console-wrap .head .spacer { flex: 1; }
.console-wrap .head .mini-btn {
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--text2);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s;
    font-family: var(--font);
    display: flex;
    align-items: center;
    gap: 5px;
    outline: none;
}
.console-wrap .head .mini-btn:hover {
    background: var(--card);
    color: var(--text);
    border-color: var(--accent);
    transform: translateY(-1px);
}
.console-wrap .head .mini-btn svg { width: 10px; height: 10px; }
#consoleBox {
    flex: 1;
    overflow-y: auto;
    padding: 12px 15px;
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--text2);
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 0;
}
#consoleBox .line { display: block; }
#consoleBox .line.info { color: var(--text2); }
#consoleBox .line.ok { color: var(--success); }
#consoleBox .line.err { color: var(--danger); }
#consoleBox .line.warn { color: var(--warn); }

.esp-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    min-height: 0;
}
.esp-view {
    flex: 1;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    color: var(--text3);
    margin: 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
}
.esp-view svg {
    width: 38px;
    height: 38px;
    animation: spin 1.8s linear infinite;
    color: var(--accent);
    filter: drop-shadow(0 0 12px var(--glow));
}
.esp-view .label {
    font-size: 10.5px;
    color: var(--text3);
    font-weight: 600;
}

.settings-outer {
    flex: 1;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    padding: 16px 16px 32px 16px;
    min-height: 0;
}
.settings-outer .settings-wrap {
    width: 100%;
    max-width: 620px;
}
.settings-hero {
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--card) 0%, var(--card2) 60%, var(--card) 100%);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    overflow: hidden;
}
.settings-hero::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, var(--glow) 0%, transparent 70%);
    opacity: 0.6;
    pointer-events: none;
    animation: haloPulse 4s ease-in-out infinite;
}
.settings-hero .avatar {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 21px;
    font-weight: 900;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 8px 24px -8px var(--glow);
}
.settings-hero .txts {
    flex: 1;
    z-index: 1;
}
.settings-hero .txts .ttl {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.3px;
    margin-bottom: 2px;
    background: linear-gradient(120deg, var(--text), var(--accent2), var(--text));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradientShift 4s ease infinite;
}
.settings-hero .txts .sub {
    font-size: 10.5px;
    color: var(--text3);
    line-height: 1.5;
}
.settings-hero .badge {
    background: var(--bg);
    border: 1px solid var(--border2);
    padding: 5px 12px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 700;
    color: var(--text2);
    letter-spacing: 0.4px;
    z-index: 1;
}
.settings-section { margin-bottom: 16px; }
.settings-section > h3 {
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text3);
    margin-bottom: 8px;
    padding-left: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.settings-section > h3::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
}
.settings-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
}
.settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
    position: relative;
}
.settings-row:last-child { border-bottom: none; }
.settings-row:hover { background: var(--card); }
.settings-row .txt {
    flex: 1;
    padding-right: 12px;
}
.settings-row .txt .name {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.settings-row .txt .name .pill-tag {
    font-size: 8px;
    font-weight: 800;
    color: var(--accent2);
    background: rgba(139,92,246,0.12);
    padding: 2px 6px;
    border-radius: 99px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
}
.settings-row .txt .name .pill-tag.danger {
    color: var(--warn);
    background: rgba(245,158,11,0.12);
}
.settings-row .txt .desc {
    font-size: 10px;
    color: var(--text3);
    line-height: 1.5;
    max-width: 400px;
}
.toggle {
    position: relative;
    width: 36px;
    height: 20px;
    flex-shrink: 0;
}
.toggle input { opacity: 0; width: 0; height: 0; }
.toggle .sl {
    position: absolute;
    inset: 0;
    background: var(--border2);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.28s;
}
.toggle .sl::before {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    left: 3px;
    top: 3px;
    background: var(--text);
    border-radius: 50%;
    transition: all 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.4);
}
.toggle input:checked + .sl {
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    box-shadow: 0 0 16px -4px var(--glow);
}
.toggle input:checked + .sl::before {
    transform: translateX(16px);
    background: #fff;
}
.segmented {
    display: inline-flex;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 3px;
    gap: 2px;
    flex-shrink: 0;
}
.segmented button {
    background: transparent;
    border: none;
    color: var(--text3);
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s;
    font-family: var(--font);
    outline: none;
}
.segmented button.active {
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    color: #fff;
    box-shadow: 0 2px 10px -4px var(--glow);
}
.segmented button:not(.active):hover {
    color: var(--text);
    background: var(--card);
}
.key-bind {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 6px 12px;
    border-radius: 7px;
    font-size: 10.5px;
    font-weight: 700;
    font-family: var(--font);
    cursor: pointer;
    transition: all 0.18s;
    min-width: 82px;
    text-align: center;
    outline: none;
}
.key-bind:hover {
    border-color: var(--accent);
    background: var(--card);
    transform: translateY(-1px);
}
.key-bind.binding {
    border-color: var(--accent);
    background: var(--card);
    animation: statusBreath 1.2s ease-in-out infinite;
}
.key-bind.danger { color: var(--warn); }
.key-bind.danger:hover {
    border-color: var(--warn);
    background: rgba(245,158,11,0.08);
}
.theme-picker {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
}
.theme-swatch {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border: 2px solid var(--border);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.4);
    position: relative;
    outline: none;
    padding: 0;
}
.theme-swatch:hover {
    transform: scale(1.16) translateY(-2px);
}
.theme-swatch.active {
    border-color: var(--text);
    transform: scale(1.06);
}
.theme-swatch .inner {
    position: absolute;
    inset: 3px;
    border-radius: 5px;
}
.theme-swatch.custom-swatch {
    background: var(--bg);
    border: 2px dashed var(--border2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text3);
    font-size: 13px;
    font-weight: 800;
}
.theme-swatch.custom-swatch.active {
    border-style: solid;
    border-color: var(--accent);
    color: var(--text);
}
.custom-picker {
    padding: 12px 14px;
    border-top: 1px solid var(--border);
    background: var(--bg);
    display: none;
}
.custom-picker.open { display: block; }
.custom-picker .row-of-colors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 9px;
}
.custom-color-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.custom-color-item label {
    font-size: 9.5px;
    font-weight: 700;
    color: var(--text3);
    letter-spacing: 0.4px;
    text-transform: uppercase;
}
.custom-color-item .input-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 5px;
    transition: all 0.15s;
}
.custom-color-item .input-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--glow);
}
.custom-color-item input[type="color"] {
    width: 24px;
    height: 24px;
    border: none;
    background: transparent;
    border-radius: 5px;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
}
.custom-color-item input[type="text"] {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text);
    font-family: var(--mono);
    font-size: 10px;
    outline: none;
    min-width: 0;
    text-transform: uppercase;
}
.custom-picker .actions {
    display: flex;
    gap: 6px;
    margin-top: 10px;
    justify-content: flex-end;
}
.custom-picker .actions button {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 10.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font);
    border: none;
    transition: all 0.15s;
    outline: none;
}
.custom-picker .actions button.ghost {
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--text2);
}
.custom-picker .actions button.ghost:hover {
    background: var(--card);
    color: var(--text);
    border-color: var(--accent);
}
.custom-picker .actions button.primary {
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    color: #fff;
}
.position-picker {
    display: flex;
    gap: 4px;
}
.position-picker button {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text2);
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s;
    font-family: var(--font);
    outline: none;
}
.position-picker button:hover {
    border-color: var(--accent);
    color: var(--text);
    transform: translateY(-1px);
}
.position-picker button.active {
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    color: #fff;
    border-color: transparent;
}
.bg-preview {
    width: 100%;
    height: 78px;
    border-radius: 7px;
    background: var(--bg);
    border: 1px solid var(--border);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text3);
    font-size: 10.5px;
    margin-bottom: 8px;
    position: relative;
    overflow: hidden;
}
.bg-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.bg-actions {
    display: flex;
    gap: 6px;
}
.bg-actions button {
    flex: 1;
    padding: 6px 10px;
    border-radius: 7px;
    font-size: 10.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font);
    border: 1px solid var(--border2);
    background: transparent;
    color: var(--text2);
    transition: all 0.15s;
    outline: none;
}
.bg-actions button:hover {
    background: var(--card);
    color: var(--text);
    border-color: var(--accent);
    transform: translateY(-1px);
}
.bg-actions button.danger:hover {
    color: var(--danger);
    border-color: rgba(239,68,68,0.3);
    background: rgba(239,68,68,0.08);
}
.version-select {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 6px 10px;
    border-radius: 7px;
    font-size: 10.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font);
    outline: none;
    transition: all 0.15s;
    min-width: 190px;
    max-width: 240px;
    text-overflow: ellipsis;
}
.version-select:hover { border-color: var(--accent); }
.version-select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--glow);
}
.version-info {
    font-size: 9.5px;
    color: var(--text3);
    margin-top: 4px;
    font-family: var(--mono);
}

.auth-panel {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 20px;
}
.auth-box {
    width: 360px;
    max-width: 100%;
    text-align: center;
}
.auth-box .icon {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    margin: 0 auto 18px;
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    font-weight: 900;
    color: #fff;
    box-shadow: 0 12px 32px -8px var(--glow);
}
.auth-box h2 {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.4px;
    margin-bottom: 6px;
}
.auth-box p {
    font-size: 11.5px;
    color: var(--text3);
    line-height: 1.65;
    margin-bottom: 20px;
}
.auth-box input {
    width: 100%;
    background: var(--panel);
    border: 1px solid var(--border2);
    border-radius: 10px;
    color: var(--text);
    padding: 12px 16px;
    font-family: var(--mono);
    font-size: 12.5px;
    text-align: center;
    letter-spacing: 3px;
    outline: none;
    transition: all 0.22s;
    margin-bottom: 10px;
}
.auth-box input::placeholder {
    color: var(--text3);
    opacity: 0.5;
    letter-spacing: 2px;
}
.auth-box input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--glow);
    background: var(--card);
}
.auth-box .submit {
    width: 100%;
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 12px;
    font-size: 12.5px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.22s;
    font-family: var(--font);
    outline: none;
    box-shadow: 0 6px 20px -8px var(--glow);
}
.auth-box .submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -8px var(--glow);
}
.auth-box .msg {
    margin-top: 10px;
    font-size: 11.5px;
    font-weight: 700;
    min-height: 16px;
}
.auth-box .msg.ok { color: var(--success); }
.auth-box .msg.err { color: var(--danger); }

#toast-wrap {
    position: fixed;
    bottom: 14px;
    right: 12px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    gap: 6px;
    pointer-events: none;
}
.toast {
    background: var(--card);
    border: 1px solid var(--border2);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 9px;
    font-size: 10.5px;
    font-weight: 600;
    box-shadow: 0 12px 40px rgba(0,0,0,0.55), 0 0 24px -10px var(--glow);
    animation: toastIn 0.34s cubic-bezier(0.2, 0.9, 0.3, 1.4);
    max-width: 320px;
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 8px;
}
.toast::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
    flex-shrink: 0;
}
.toast.err { border-color: rgba(239,68,68,0.4); }
.toast.err::before {
    background: var(--danger);
    box-shadow: 0 0 10px var(--danger);
}
@keyframes toastIn {
    from { opacity: 0; transform: translateX(28px) scale(0.94); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }

/* ═══════════════════════════════════════════════════════════════════════════
   RELIABLE IN-WINDOW TOPBAR
   ═══════════════════════════════════════════════════════════════════════════ */
#deadwae-topbar {
    position: fixed;
    z-index: 5000;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: none;
    align-items: center;
    gap: 3px;
    padding: 5px 7px;
    border: 1px solid color-mix(in srgb, var(--border) 80%, white 8%);
    border-radius: 18px;
    background: color-mix(in srgb, var(--panel) 88%, black 12%);
    box-shadow: 0 14px 42px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.025) inset;
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
}
#deadwae-topbar.show { display:flex; animation: topbarIn .28s cubic-bezier(.2,.8,.2,1); }
@keyframes topbarIn {
    from { opacity:0; transform:translate(-50%,-8px) scale(.94); }
    to { opacity:1; transform:translate(-50%,0) scale(1); }
}
#deadwae-topbar .nav-btn,
#deadwae-topbar .premium-btn,
#deadwae-topbar .close-btn {
    border:0;
    cursor:pointer;
    color:var(--text3);
    background:transparent;
    outline:none;
    font-family:var(--font);
}
#deadwae-topbar .nav-btn {
    width:31px;
    height:31px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:.18s ease;
}
#deadwae-topbar .nav-btn svg { width:14px;height:14px;stroke-width:2; }
#deadwae-topbar .nav-btn:hover {
    color:var(--text);
    background:rgba(255,255,255,.065);
    transform:translateY(-1px);
}
#deadwae-topbar .nav-btn.active {
    color:var(--text);
    background:color-mix(in srgb,var(--accent) 15%,transparent);
    box-shadow:0 0 18px var(--glow);
}
#deadwae-topbar .divider {
    width:1px;height:17px;
    margin:0 3px;
    background:linear-gradient(transparent,rgba(255,255,255,.13),transparent);
}
#deadwae-topbar .premium-btn {
    padding:7px 10px;
    border-radius:10px;
    font-size:9px;
    font-weight:800;
    color:var(--gold);
}
#deadwae-topbar .premium-btn:hover { background:rgba(251,191,36,.08); }
#deadwae-topbar .close-btn {
    width:27px;height:27px;border-radius:9px;font-size:12px;
}
#deadwae-topbar .close-btn:hover { background:rgba(239,68,68,.12);color:#f87171; }
#deadwae-topbar .topbar-status {
    width:5px;height:5px;border-radius:50%;
    background:var(--success);
    box-shadow:0 0 9px var(--success);
    margin:0 4px 0 2px;
}



/* Attached topbar polish: no native-window border, smooth reveal, theme-safe placement. */
#deadwae-topbar {
    border: 0 !important;
    outline: 0 !important;
    box-shadow: 0 14px 42px rgba(0,0,0,.36), 0 0 30px -18px var(--glow) !important;
    transition: opacity .28s ease, transform .32s cubic-bezier(.2,.8,.2,1), filter .32s ease;
}
#deadwae-topbar:not(.show) {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
}
#deadwae-topbar.pos-top {
    top: 10px;
    left: 50%;
    right: auto;
    bottom: auto;
    transform: translateX(-50%);
}
#deadwae-topbar.pos-bottom {
    top: auto;
    left: 50%;
    right: auto;
    bottom: 10px;
    transform: translateX(-50%);
}
#deadwae-topbar.pos-left {
    top: 50%;
    left: 10px;
    right: auto;
    bottom: auto;
    transform: translateY(-50%);
    flex-direction: column;
}
#deadwae-topbar.pos-right {
    top: 50%;
    left: auto;
    right: 10px;
    bottom: auto;
    transform: translateY(-50%);
    flex-direction: column;
}
#deadwae-topbar.pos-top.show,
#deadwae-topbar.pos-bottom.show {
    animation: attachedTopbarIn .34s cubic-bezier(.2,.8,.2,1);
}
#deadwae-topbar.pos-left.show,
#deadwae-topbar.pos-right.show {
    animation: attachedSideTopbarIn .34s cubic-bezier(.2,.8,.2,1);
}
@keyframes attachedTopbarIn {
    from { opacity: 0; filter: blur(4px); }
    to { opacity: 1; filter: blur(0); }
}
@keyframes attachedSideTopbarIn {
    from { opacity: 0; filter: blur(4px); }
    to { opacity: 1; filter: blur(0); }
}

#post-license-loading {
    position:fixed; inset:0; z-index:10000;
    display:flex; align-items:center; justify-content:center;
    background:var(--bg);
    opacity:0; pointer-events:none;
    transition:opacity .62s cubic-bezier(.2,.8,.2,1);
}
#post-license-loading.show { opacity:1; pointer-events:auto; }
#post-license-loading.hide { opacity:0; }
#post-license-loading .pl-card {
    width:330px; padding:30px 30px 25px;
    text-align:center;
    border:1px solid rgba(255,255,255,.075);
    border-radius:24px;
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
    box-shadow:0 30px 100px rgba(0,0,0,.5), inset 0 1px rgba(255,255,255,.04);
    backdrop-filter:blur(20px);
}
#post-license-loading .pl-logo {
    font-family:'Segoe Script','Brush Script MT','Lucida Handwriting',cursive;
    font-size:55px; line-height:1;
    font-style:italic;
    color:var(--accent2);
    text-shadow:0 0 28px var(--glow);
}
#post-license-loading .pl-sub {
    margin-top:7px;
    font-size:8px; font-weight:800; letter-spacing:2.4px;
    color:var(--text3);
}
#post-license-loading .pl-status {
    margin-top:25px;
    font-size:10px; color:var(--text2);
}
#post-license-loading .pl-track {
    margin-top:12px;height:3px;border-radius:99px;
    background:rgba(255,255,255,.06);overflow:hidden;
}
#post-license-loading .pl-bar {
    width:0;height:100%;border-radius:99px;
    background:linear-gradient(90deg,var(--accent),var(--accent2));
    box-shadow:0 0 16px var(--glow);
    transition:width .8s cubic-bezier(.2,.8,.2,1);
}


/* V5 PREMIUM INTERACTION LAYER */
body::before{content:"";position:fixed;inset:-30%;pointer-events:none;z-index:0;background:radial-gradient(circle at 15% 20%,color-mix(in srgb,var(--accent) 12%,transparent),transparent 25%),radial-gradient(circle at 85% 25%,color-mix(in srgb,var(--gradient2) 10%,transparent),transparent 25%),radial-gradient(circle at 50% 90%,color-mix(in srgb,var(--accent2) 8%,transparent),transparent 30%);filter:blur(30px);animation:dwAmbient 18s ease-in-out infinite alternate}
@keyframes dwAmbient{0%{transform:translate(-1%,0) scale(1)}50%{transform:translate(2%,-1%) scale(1.04)}100%{transform:translate(-1%,2%) scale(1.02)}}
button:not(:disabled),.card,.flag-row,.preset-card,.settings-card,.settings-row,.stat-card,.hub-card,.hero-card,.editor-header,.console-wrap{transition:transform .24s cubic-bezier(.2,.8,.2,1),border-color .24s ease,box-shadow .3s ease,filter .24s ease}
button:not(:disabled):hover{transform:translateY(-2px);filter:brightness(1.08)}
button:not(:disabled):active{transform:translateY(0) scale(.965)}
.card:hover,.flag-row:hover,.preset-card:hover,.settings-card:hover,.settings-row:hover,.stat-card:hover,.hub-card:hover,.hero-card:hover,.editor-header:hover,.console-wrap:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--accent) 50%,var(--border));box-shadow:0 16px 48px rgba(0,0,0,.22),0 0 32px -18px var(--glow)}
input:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--border2))!important;box-shadow:0 0 24px -16px var(--glow)}
input:focus{border-color:var(--accent)!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 12%,transparent),0 0 28px -12px var(--glow)!important}
.dwae-logo{font-family:"Segoe Script","Brush Script MT","Lucida Handwriting",cursive!important;font-style:italic!important;background:linear-gradient(100deg,var(--accent2),var(--gradient2),var(--accent));background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent!important;text-shadow:0 0 22px var(--glow);animation:dwLogo 5s ease-in-out infinite}
@keyframes dwLogo{0%,100%{background-position:0% 50%;transform:skewX(-2deg)}50%{background-position:100% 50%;transform:skewX(2deg)}}
.panel.active{animation:dwPanel .36s cubic-bezier(.2,.8,.2,1)}
@keyframes dwPanel{from{opacity:0;transform:translateY(7px) scale(.994);filter:blur(2px)}to{opacity:1;transform:none;filter:none}}
</style>
