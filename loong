"""

def _on_webview_start():
    try:
        pos = load_settings().get("topbar_position", "top")
        if _main_window:
            _main_window.evaluate_js(
                "window.deadwaeSetTopbarPosition && window.deadwaeSetTopbarPosition(" +
                json.dumps(pos) + ");"
            )
    except Exception as e:
        push("topbar position: " + str(e))

    # Never reveal the navigation until the normal loading/license flow has
    # explicitly approved it.
    if not _licensed:
        hide_topbar()

def main():
    global _injector, _main_window, _topbar_window, _tray_icon, _licensed

    push(APP_NAME + " v" + APP_VERSION + " starting...")

    # The splash is a native WebView and is created BEFORE the heavy injector,
    # tray and hotkey work. It is therefore the first visible thing on launch.
    splash_theme = get_effective_theme()
    splash_html = STARTUP_SPLASH_HTML
    splash_html = splash_html.replace("#07070b", splash_theme.get("bg", "#07070b"), 1)
    splash_html = splash_html.replace("#eaeaf5", splash_theme.get("text", "#eaeaf5"), 1)
    splash_html = splash_html.replace("#a78bfa", splash_theme.get("accent2", "#a78bfa"), 1)
    splash_html = splash_html.replace("#8b5cf6", splash_theme.get("accent", "#8b5cf6"))

    sw, sh = get_screen_size()
    splash_w, splash_h = 560, 350
    splash_x = (sw - splash_w) // 2
    splash_y = (sh - splash_h) // 2

    startup_splash = webview.create_window(
        title="Deadwae — Starting",
        html=splash_html,
        width=splash_w,
        height=splash_h,
        x=splash_x,
        y=splash_y,
        resizable=False,
        frameless=True,
        easy_drag=False,
        on_top=True,
        background_color=splash_theme.get("bg", "#07070b"),
    )

    # Heavy initialization happens while the splash is already visible.
    _licensed = False
    _injector = HybridInjector(log_cb=push)

    if _pystray_available:
        start_tray_thread()

    initial_key = load_settings().get("toggle_key", "Insert")
    try:
        start_hotkey(initial_key)
    except Exception as e:
        push("Hotkey: " + str(e))

    main_w, main_h = 980, 620
    main_x = (sw - main_w) // 2
    main_y = (sh - main_h) // 2

    td = get_effective_theme()
    replacements = {
        "__THEME_BG__": td.get("bg", "#07070b"),
        "__THEME_PANEL__": td.get("panel", "#0d0d12"),
        "__THEME_CARD__": td.get("card", "#141420"),
        "__THEME_CARD2__": td.get("card2", "#1b1b2a"),
        "__THEME_BORDER__": td.get("border", "#1e1e2e"),
        "__THEME_BORDER2__": td.get("border2", "#2a2a40"),
        "__THEME_TEXT__": td.get("text", "#eaeaf5"),
        "__THEME_TEXT2__": td.get("text2", "#9d9dba"),
        "__THEME_TEXT3__": td.get("text3", "#6a6a88"),
        "__THEME_ACCENT__": td.get("accent", "#8b5cf6"),
        "__THEME_ACCENT2__": td.get("accent2", "#a78bfa"),
        "__THEME_GLOW__": td.get("glow", "rgba(139,92,246,.5)"),
        "__THEME_SUCCESS__": td.get("success", "#34d399"),
        "__THEME_GOLD__": td.get("gold", "#fbbf24"),
        "__THEME_GRADIENT1__": td.get("gradient1", td.get("accent", "#8b5cf6")),
        "__THEME_GRADIENT2__": td.get("gradient2", td.get("accent2", "#ec4899")),
    }
    main_html = APP_HTML.replace("__LOGO__", LOGO_SVG)
    for k, v in replacements.items():
        main_html = main_html.replace(k, v)

    # Main UI is created hidden. Nothing from it can flash behind the license screen.
    _main_window = webview.create_window(
        title=APP_NAME,
        html=main_html,
        js_api=MainApi(),
        width=main_w,
        height=main_h,
        x=main_x,
        y=main_y,
        resizable=True,
        frameless=True,
        easy_drag=True,
        background_color=td.get("bg", "#07070b"),
        hidden=True,
    )

    _topbar_window = None

    try:
        s = load_settings()
        if s.get("streamproof"):
            threading.Timer(3.0, lambda: apply_streamproof(True)).start()
        if s.get("disguise_mode"):
            threading.Timer(1.5, lambda: apply_disguise(True)).start()
        if s.get("performance_mode"):
            threading.Timer(0.5, lambda: apply_performance_mode(s.get("performance_mode"))).start()
        if s.get("dev_mode"):
            threading.Timer(2.5, lambda: _toggle_dev_console(True)).start()
    except Exception:
        pass

    # JS starts the real themed loading sequence only after the native splash
    # has had time to establish itself. The splash remains until that handoff.
    def close_splash_after_startup():
        # Reveal the real WebView only after the splash has occupied the first
        # stage. Its own loading/license overlay is already initialized, so
        # there is no blank main window between stages.
        try:
            if _main_window:
                _main_window.show()
        except Exception as e:
            push("main reveal: " + str(e))
        try:
            startup_splash.destroy()
        except Exception:
            pass

    threading.Timer(3.8, close_splash_after_startup).start()

    webview.start(_on_webview_start, debug=False)

    try:
        stop_hotkey()
    except Exception:
        pass
    try:
        if _tray_icon:
            _tray_icon.stop()
    except Exception:
        pass

if __name__ == "__main__":
    main()
