def get_flag_kind(n):
    ft = get_flag_type(n)
    if ft is None:
        return None
    if ft in ("FFlag", "DFFlag", "SFFlag"):
        return "bool"
    if ft in ("FInt", "DFInt", "SFInt"):
        return "int"
    if ft in ("FLog", "DFLog", "SFLog"):
        return "log"
    if ft in ("FString", "DFString", "SFString"):
