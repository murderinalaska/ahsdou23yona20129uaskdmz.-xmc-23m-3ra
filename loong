        return {
            "ok": r["fail"] == 0,
            "success": r["success"],
            "failed": r["fail"],
            "startup_restored": r.get("startup_restored", 0),
        }

    def list_presets(self):
        return {"presets": _presets.list()}

    def save_preset(self, n, p):
        try:
            ok, err = _presets.save(n, json.loads(p))
            if ok:
                return {"ok": True}
            return {"ok": False, "error": err or "unknown"}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def load_preset(self, n):
        return {"flags": _presets.get(n) or {}}

    def delete_preset(self, n):
        return {"ok": _presets.delete(n)}

    def merge_preset_into_current(self, n, c):
        try:
            m = _presets.merge_into_current(n, json.loads(c) if c else {})
            if m is None:
                return {"ok": False}
            return {"ok": True, "flags": m, "count": len(m)}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def merge_current_into_preset(self, n, c):
        try:
            m = _presets.merge_current_into(n, json.loads(c) if c else {})
            if m is None:
                return {"ok": False}
            return {"ok": True, "flags": m, "count": len(m)}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def parse_multi(self, t):
        try:
            flags, src = parse_multi_flag_input(t)
            return {"ok": True, "flags": flags, "source": src, "count": len(flags)}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def get_settings(self):
        return load_settings()

    def save_setting(self, k, v):
        s = load_settings()
        s[k] = v
        save_settings(s)
        if k == "reapplyActive":
            _injector.set_monitoring(v)
        if k == "live_apply":
            _injector.live_apply_enabled = bool(v)
        if k == "toggle_key":
            try:
                start_hotkey(v)
            except Exception:
                pass
        if k == "topbar_position":
            _position_topbar()
        if k == "streamproof":
            apply_streamproof(v)
        if k == "disguise_mode":
            apply_disguise(v)
        if k == "performance_mode":
            apply_performance_mode(v)
        if k == "dev_mode":
            _toggle_dev_console(v)
        return {"ok": True}

    def get_theme(self):
        return {
            "theme": load_settings().get("theme", "deadwae"),
            "data": get_effective_theme(),
        }

    def save_theme(self, n):
        s = load_settings()
        s["theme"] = n
        save_settings(s)
        return {"ok": True, "theme": n, "data": get_effective_theme()}

    def get_themes(self):
        o = {}
        for k, v in THEMES.items():
            o[k] = {"name": v["name"], "accent": v["accent"], "accent2": v["accent2"]}
        return {
            "themes": o,
            "current": load_settings().get("theme", "deadwae"),
            "custom": load_settings().get("custom_theme", {}),
        }

    def save_custom_theme(self, p):
        try:
            d = json.loads(p)
            if not isinstance(d, dict):
                return {"ok": False}
            s = load_settings()
            s["custom_theme"] = d
            s["theme"] = CUSTOM_THEME_KEY
            save_settings(s)
            return {"ok": True}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def get_custom_theme(self):
        return {"custom": load_settings().get("custom_theme", {})}

    def get_terminal_buffer(self):
        with _LOG_LOCK:
            return list(_LOG_BUFFER)

    def clear_log(self):
        with _LOG_LOCK:
            _LOG_BUFFER.clear()
        return {"ok": True}

    def show_main(self):
        try:
            if _main_window:
                _main_window.show()
        except Exception:
            pass
        return {"ok": True}

    def hide_main(self):
        try:
            if _main_window:
                _main_window.hide()
        except Exception:
            pass
        return {"ok": True}

    def on_loading_done(self):
        if _licensed:
            show_topbar_if_licensed()
        return {"ok": True}

    def hide_topbar(self):
        hide_topbar()
        return {"ok": True}

    def move_topbar(self, pos):
        s = load_settings()
        if pos in TOPBAR_SIZES:
            s["topbar_position"] = pos
            save_settings(s)
            _position_topbar()
        return {"ok": True}

    def refresh_topbar(self):
        try:
            if _main_window:
                pos = load_settings().get("topbar_position", "top")
                _main_window.evaluate_js(
                    "window.deadwaeSetTopbarPosition && window.deadwaeSetTopbarPosition(" +
                    json.dumps(pos) + ");"
                )
                if _licensed:
                    _main_window.evaluate_js(
                        "window.showMainTopbar && window.showMainTopbar();"
                    )
        except Exception as e:
            push("refresh topbar: " + str(e))
        return {"ok": True}

    def apply_colorkey(self):
        # Kept for compatibility with older UI calls. Attached topbars do not
        # need Windows color-key transparency.
        return {"ok": True}

def _toggle_dev_console(enable):
    global _DEV_CONSOLE_WINDOW
    if enable:
        if _DEV_CONSOLE_WINDOW is not None:
            try:
                _DEV_CONSOLE_WINDOW.show()
            except Exception:
                pass
            return
        try:
            sw, sh = get_screen_size()
            _DEV_CONSOLE_WINDOW = webview.create_window(
                title="Deadwae Dev Console",
                html=DEV_CONSOLE_HTML,
                js_api=MainApi(),
                width=680,
                height=380,
                x=sw - 710,
                y=sh - 420,
                resizable=True,
                frameless=True,
                easy_drag=True,
                on_top=False,
                background_color="#050508",
            )
            push("Dev console opened")
        except Exception as e:
            push("Dev console: " + str(e))
            _DEV_CONSOLE_WINDOW = None
    else:
        if _DEV_CONSOLE_WINDOW is not None:
            try:
                _DEV_CONSOLE_WINDOW.destroy()
            except Exception:
                pass
            _DEV_CONSOLE_WINDOW = None
            push("Dev console closed")

