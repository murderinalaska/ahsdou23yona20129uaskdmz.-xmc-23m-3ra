            dd.appendChild(item);
        }
        if (!insts.length) {
            const e = document.createElement('div');
            e.className = 'empty';
            e.innerHTML = 'No Roblox instances attached.<br>Launch Roblox and it will appear here.';
            dd.appendChild(e);
        }
    } catch (e) {}
