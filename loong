#keyscreen { background:radial-gradient(circle at 50% 25%,var(--glow),transparent 25%),radial-gradient(circle at 12% 82%,color-mix(in srgb,var(--accent) 13%,transparent),transparent 30%),radial-gradient(circle at 88% 12%,color-mix(in srgb,var(--accent2) 10%,transparent),transparent 25%),var(--bg); }
#keyscreen::before { background-image:linear-gradient(rgba(255,255,255,.014) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.014) 1px,transparent 1px); background-size:34px 34px; mask-image:radial-gradient(circle at center,#000 0%,transparent 76%); opacity:.8; }
#keyscreen::after { width:620px; height:620px; border-color:color-mix(in srgb,var(--accent2) 9%,transparent); box-shadow:0 0 120px var(--glow),inset 0 0 90px color-mix(in srgb,var(--accent) 6%,transparent); }
#keyscreen .auth-orbit { position:absolute; width:520px; height:180px; border-radius:50%; border:1px solid rgba(255,255,255,.035); transform:rotate(-24deg); pointer-events:none; }
#keyscreen .auth-orbit-a { box-shadow:0 0 35px var(--glow); }
#keyscreen .auth-orbit-b { width:700px; height:240px; transform:rotate(26deg); opacity:.55; }
#keyscreen .box { width:430px; max-width:90%; padding:30px 36px 24px; border-radius:26px; background:linear-gradient(145deg,color-mix(in srgb,var(--card) 86%,transparent),color-mix(in srgb,var(--bg) 92%,transparent)); border:1px solid color-mix(in srgb,var(--border2) 72%,transparent); box-shadow:0 35px 100px rgba(0,0,0,.58),0 0 0 1px color-mix(in srgb,var(--accent) 5%,transparent),0 0 70px var(--glow),inset 0 1px 0 rgba(255,255,255,.055); backdrop-filter:blur(24px) saturate(1.15); }
#keyscreen .auth-kicker { display:flex; align-items:center; justify-content:center; gap:7px; margin-bottom:5px; color:rgba(255,255,255,.34); font-size:7.5px; font-weight:800; letter-spacing:2.4px; }
#keyscreen .auth-kicker span { width:18px; height:1px; background:linear-gradient(90deg,transparent,var(--accent2)); }
#keyscreen .auth-kicker span:last-child { background:linear-gradient(90deg,var(--accent),transparent); }
#keyscreen .auth-subbrand { margin:0 auto 15px; color:rgba(255,255,255,.27); font:700 7px/1 'Inter',sans-serif; letter-spacing:2px; }
#keyscreen .auth-subbrand b { color:var(--accent2); font-size:6px; }
#keyscreen .box h1 { font-size:22px; font-weight:800; letter-spacing:-.65px; margin-bottom:6px; color:#f7f2fb; background:none; -webkit-text-fill-color:initial; }
#keyscreen .box p { margin-bottom:23px; color:rgba(255,255,255,.42); }
#keyscreen .field-wrap { margin-bottom:11px; }
#keyscreen .field-icon { position:absolute; z-index:2; left:14px; top:50%; transform:translateY(-50%); color:rgba(244,114,182,.62); font-size:11px; pointer-events:none; }
#keyscreen .field { height:48px; padding:14px 40px; background:rgba(4,4,8,.62); border-color:rgba(255,255,255,.075); border-radius:13px; box-shadow:inset 0 1px 0 rgba(255,255,255,.025),0 8px 30px rgba(0,0,0,.18); }
#keyscreen .field:hover { border-color:rgba(255,255,255,.13); }
#keyscreen .field:focus { border-color:var(--accent2); box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 12%,transparent),0 0 30px var(--glow),inset 0 1px 0 rgba(255,255,255,.03); }
#keyscreen .btn-activate { height:46px; border-radius:13px; display:flex; align-items:center; justify-content:center; gap:10px; background:linear-gradient(110deg,#9f67e8,#e85ca7 55%,#b879ed); box-shadow:0 12px 30px -9px rgba(236,72,153,.48),inset 0 1px 0 rgba(255,255,255,.22); }
#keyscreen .btn-activate::before { content:''; position:absolute; inset:0; background:linear-gradient(105deg,transparent 15%,rgba(255,255,255,.16) 45%,transparent 68%); transform:translateX(-120%); transition:transform .55s ease; }
#keyscreen .btn-activate:hover::before { transform:translateX(120%); }
#keyscreen .btn-activate span,#keyscreen .btn-activate b { position:relative; z-index:1; }
#keyscreen .btn-activate b { font-size:15px; font-weight:500; transition:transform .2s; }
#keyscreen .btn-activate:hover b { transform:translate(2px,-2px); }
#keyscreen .auth-foot { margin-top:16px; display:flex; align-items:center; justify-content:center; gap:6px; color:rgba(255,255,255,.22); font-size:7.5px; }
#keyscreen .status-dot { width:4px; height:4px; border-radius:50%; background:var(--accent2); box-shadow:0 0 8px var(--glow); animation:statusBreath 2s ease-in-out infinite; }
#keyscreen .msg { margin-top:9px; }
#header .brand { gap:9px; align-items:center; }
#header .brand .tag { margin-top:4px; }

/* ═══════════════════════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════════════════════ */
#header {
    height: 44px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0 10px;
    gap: 8px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 100;
    cursor: default;
}
#header .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
}
#header .brand img {
    width: 22px;
    height: 22px;
}
.wave-brand {
    display: inline-flex;
    gap: 0.5px;
    font-size: 13.5px;
    font-weight: 900;
    letter-spacing: -0.4px;
    background: linear-gradient(120deg, var(--gradient1), var(--gradient2), var(--gradient1));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradientShift 3.6s ease infinite;
}
#header .brand .tag {
    font-size: 9.5px;
    color: var(--text3);
    font-weight: 600;
}
#header .sp { flex: 1; }
#header .hbtn {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: transparent;
    border: none;
    color: var(--text3);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    transition: all 0.15s;
    outline: none;
}
#header .hbtn:hover {
    background: var(--card);
    color: var(--text);
    transform: scale(1.1);
}
#header .hbtn.close:hover {
    background: rgba(239,68,68,0.18);
    color: var(--danger);
}
#instance-select {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 99px;
    font-size: 10px;
    font-weight: 600;
    color: var(--text2);
    cursor: pointer;
    transition: all 0.2s;
    max-width: 200px;
}
#instance-select:hover { border-color: var(--accent); }
#instance-select .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #33333d;
    transition: all 0.3s;
}
#instance-select.on .dot {
    background: var(--success);
    box-shadow: 0 0 10px var(--success);
    animation: statusBreath 1.8s ease-in-out infinite;
}
#instance-select .txt {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#instance-select .caret { font-size: 7px; opacity: 0.6; }
#instance-dropdown {
    position: absolute;
    top: 44px;
    right: 50px;
    min-width: 240px;
    background: var(--card);
    border: 1px solid var(--border2);
    border-radius: 10px;
    padding: 4px;
    z-index: 9999;
    box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 30px -10px var(--glow);
    display: none;
    animation: menuIn 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.4);
    max-height: 320px;
    overflow-y: auto;
}
#instance-dropdown.open { display: block; }
#instance-dropdown .inst-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 11px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.14s;
}
#instance-dropdown .inst-item:hover {
    background: var(--card2);
    transform: translateX(3px);
}
#instance-dropdown .inst-item.active { background: var(--card2); }
#instance-dropdown .inst-item .ind {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
    flex-shrink: 0;
}
#instance-dropdown .inst-item .info { flex: 1; min-width: 0; }
#instance-dropdown .inst-item .info .n1 {
    font-size: 11px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#instance-dropdown .inst-item .info .n2 {
    font-size: 9px;
    color: var(--text3);
    font-family: var(--mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#instance-dropdown .inst-item .badge {
    font-size: 8px;
    font-weight: 800;
    color: var(--accent2);
    background: rgba(139,92,246,0.12);
    padding: 2px 7px;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    flex-shrink: 0;
}
#instance-dropdown .empty {
    text-align: center;
    padding: 20px 12px;
    color: var(--text3);
    font-size: 10.5px;
    line-height: 1.7;
}
@keyframes statusBreath {
    0%, 100% { transform: scale(1);   opacity: 1; }
    50%      { transform: scale(1.4); opacity: 0.5; }
}
@keyframes menuIn {
    from { opacity: 0; transform: scale(0.94) translateY(-4px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}

#workspace {
    flex: 1;
    position: relative;
    overflow: hidden;
    z-index: 1;
}
.panel {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    padding: 8px;
    overflow: hidden;
}
.panel.active {
    display: flex;
    animation: panelIn 0.28s cubic-bezier(0.2, 0.9, 0.3, 1);
}
@keyframes panelIn {
    from { opacity: 0; transform: translateY(8px) scale(0.995); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* EDITOR */
.editor-split {
    flex: 1;
    display: flex;
    gap: 8px;
    min-height: 0;
    overflow: hidden;
}
.editor-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    min-width: 0;
    transition: border-color 0.3s;
}
.editor-main:hover { border-color: var(--border2); }
.editor-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
}
.editor-header .page-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
    font-size: 11px;
    font-weight: 700;
}
.editor-header .page-tag .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
    animation: statusBreath 2s ease-in-out infinite;
}
.editor-header .page-tag .flag-count {
    font-size: 9.5px;
    font-weight: 700;
    color: var(--text3);
    background: var(--card);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 99px;
    margin-left: 4px;
    letter-spacing: 0.3px;
    transition: all 0.25s;
}
.editor-header .page-tag .flag-count.bump {
    transform: scale(1.15);
    border-color: var(--accent);
    color: var(--accent2);
}
.editor-header .spacer { flex: 1; }
.editor-header .icon-btn {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--text2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.4);
    outline: none;
}
.editor-header .icon-btn:hover {
    background: var(--card2);
    color: var(--text);
    border-color: var(--accent);
    transform: translateY(-2px) scale(1.08);
    box-shadow: 0 4px 14px -6px var(--glow);
}
.editor-header .icon-btn:active { transform: scale(0.94); }
.editor-header .icon-btn svg { width: 11px; height: 11px; }
.search-bar {
    position: relative;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
}
.search-bar .search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    color: var(--text3);
    pointer-events: none;
    transition: all 0.2s;
}
.search-bar:focus-within .search-icon {
    color: var(--accent);
    transform: translateY(-50%) scale(1.1);
}
.search-bar input {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    padding: 7px 30px 7px 32px;
    height: 32px;
    font-size: 11px;
    font-family: var(--font);
    outline: none;
    transition: all 0.18s;
}
.search-bar input::placeholder { color: var(--text3); }
.search-bar input:focus {
    border-color: var(--accent);
    background: var(--card2);
    box-shadow: 0 0 0 3px var(--glow);
}
.search-bar .search-clear {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    background: transparent;
    border: none;
    border-radius: 50%;
    color: var(--text3);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
    outline: none;
}
.search-bar .search-clear:hover {
    background: var(--card);
    color: var(--danger);
    transform: translateY(-50%) rotate(90deg);
}
.search-bar .search-clear svg { width: 9px; height: 9px; }

.flag-list {
    flex: 1;
    overflow-y: auto;
    padding: 5px 6px;
    min-height: 0;
}
.flag-row {
    display: grid;
    grid-template-columns: 58px 1fr 96px 24px;
    gap: 8px;
    align-items: center;
    padding: 6px 8px;
    border-radius: 7px;
    transition: all 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.2);
    animation: rowIn 0.28s ease;
    position: relative;
}
@keyframes rowIn {
    from { opacity: 0; transform: translateX(-6px); }
    to   { opacity: 1; transform: translateX(0); }
}
.flag-row:hover {
    background: var(--card);
    transform: translateX(2px);
}
.flag-row .type-tag {
    font-size: 9px;
    font-weight: 800;
    font-family: var(--mono);
    padding: 3px 5px;
    border-radius: 5px;
    text-align: center;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    border: 1px solid;
    transition: all 0.2s;
}
.flag-row:hover .type-tag { transform: scale(1.06); }
.flag-row .type-tag.bool    { color: #6ee7b7; background: rgba(110,231,183,0.06); border-color: rgba(110,231,183,0.18); }
.flag-row .type-tag.int     { color: #93c5fd; background: rgba(147,197,253,0.06); border-color: rgba(147,197,253,0.18); }
.flag-row .type-tag.log     { color: #fcd34d; background: rgba(252,211,77,0.06);  border-color: rgba(252,211,77,0.18); }
.flag-row .type-tag.string  { color: #f0abfc; background: rgba(240,171,252,0.06); border-color: rgba(240,171,252,0.18); }
.flag-row .type-tag.unknown { color: var(--text3); background: var(--card); border-color: var(--border); }
.flag-row .name {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.flag-row .value-input {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    padding: 5px 9px;
    font-family: var(--mono);
    font-size: 10.5px;
    text-align: right;
    outline: none;
    transition: all 0.15s;
}
.flag-row .value-input:focus {
    border-color: var(--accent);
    background: var(--panel);
    box-shadow: 0 0 0 3px var(--glow);
}
.flag-row .remove-btn {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text3);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.16s;
    outline: none;
}
.flag-row:hover .remove-btn { opacity: 1; }
.flag-row .remove-btn:hover {
    background: rgba(239,68,68,0.1);
    border-color: rgba(239,68,68,0.3);
    color: var(--danger);
    transform: scale(1.1) rotate(90deg);
}
.flag-row .remove-btn svg { width: 11px; height: 11px; }

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 30px 16px;
    text-align: center;
    animation: fadeUp 0.4s ease;
}
.empty-state .icon-big {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--card), var(--card2));
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    color: var(--accent);
    box-shadow: 0 0 40px -14px var(--glow);
}
.empty-state .icon-big svg { width: 24px; height: 24px; }
.empty-state h3 {
    font-size: 13.5px;
    font-weight: 800;
    margin-bottom: 5px;
    background: linear-gradient(120deg, var(--text), var(--accent2), var(--text));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradientShift 4s ease infinite;
}
.empty-state p {
    font-size: 10.5px;
    color: var(--text3);
    max-width: 320px;
    line-height: 1.6;
}
.empty-state p b { color: var(--accent2); }

.editor-footer {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 7px 9px;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
}
.editor-footer .foot-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    background: transparent;
    border: none;
    color: var(--text2);
    padding: 6px 10px;
    border-radius: 7px;
    font-size: 10.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.9, 0.3, 1.3);
    font-family: var(--font);
    outline: none;
    position: relative;
}
.editor-footer .foot-btn:hover {
    background: var(--card);
    color: var(--text);
    transform: translateY(-2px);
}
.editor-footer .foot-btn:active { transform: translateY(0) scale(0.97); }
.editor-footer .foot-btn.primary {
    background: linear-gradient(135deg, var(--gradient1), var(--gradient2));
    color: #fff;
    box-shadow: 0 4px 16px -6px var(--glow);
}
.editor-footer .foot-btn.primary:hover {
    box-shadow: 0 8px 26px -6px var(--glow);
    transform: translateY(-2px);
}
.editor-footer .foot-btn.danger { color: var(--warn); }
.editor-footer .foot-btn.danger:hover {
    background: rgba(245,158,11,0.1);
    color: var(--warn);
}
.editor-footer .foot-btn svg { width: 11px; height: 11px; }
.editor-footer .spacer { flex: 1; }
.editor-footer .foot-btn.loading {
    pointer-events: none;
    opacity: 0.75;
}
.editor-footer .foot-btn.loading::after {
    content: '';
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 9px;
    height: 9px;
    border: 1.5px solid rgba(255,255,255,0.25);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
}
@keyframes spin {
    to { transform: translateY(-50%) rotate(360deg); }
}

.editor-side {
    width: 232px;
    flex-shrink: 0;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.3s;
}
.editor-side:hover { border-color: var(--border2); }
.editor-side .side-header {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
}
.editor-side .side-header .title {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text);
}
.editor-side .side-header .title svg {
    width: 12px;
    height: 12px;
    color: var(--accent);
}
.add-flag-form {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid var(--border);
}
.add-flag-form .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
}
.add-flag-form .field label {
    font-size: 8.5px;
    font-weight: 800;
    color: var(--text3);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 5px;
}
.add-flag-form .field label .auto {
    font-size: 7.5px;
    color: var(--accent2);
    background: rgba(139,92,246,0.12);
    padding: 1px 5px;
    border-radius: 99px;
    letter-spacing: 0.4px;
    font-weight: 800;
}
.add-flag-form input {
