function updateFlag(name, value) { flags[name] = value; saveLocal(); }
function removeFlag(name) { delete flags[name]; render(); saveLocal(); }

function detectPrefixClient(name, value) {
    const p = ['DFString','SFString','FString','DFFlag','SFFlag','FFlag',
               'DFInt','SFInt','FInt','DFLog','SFLog','FLog'];
    for (const x of p) if (name.startsWith(x)) return x;
    const v = String(value || 'true').trim().toLowerCase();
    if (['true','false','1','0','yes','no','on','off'].includes(v)) return 'FFlag';
    if (/^-?\d+$/.test(v)) return 'FInt';
    return 'FString';
}
function detectKindClient(prefix) {
    if (prefix.startsWith('DF') || prefix.startsWith('SF')) {
        const c = prefix.slice(2);
        if (c === 'Flag') return 'bool';
        if (c === 'Int') return 'int';
        if (c === 'Log') return 'log';
        if (c === 'String') return 'string';
    }
    if (prefix === 'FFlag') return 'bool';
    if (prefix === 'FInt') return 'int';
    if (prefix === 'FLog') return 'log';
    if (prefix === 'FString') return 'string';
    return 'bool';
}
function updateAddPreview() {
    const name = document.getElementById('addName').value.trim();
    const val = document.getElementById('addValue').value.trim() || 'true';
    const tEl = document.getElementById('addPreviewText');
    const bEl = document.getElementById('addPreviewBadge');
    const pEl = document.getElementById('addPreview');
    if (!name) {
        tEl.textContent = 'Waiting for name...';
        bEl.textContent = '—';
        pEl.classList.remove('valid');
        return;
    }
    const prefix = detectPrefixClient(name, val);
    let fullName;
    const known = ['DFString','SFString','FString','DFFlag','SFFlag','FFlag',
                   'DFInt','SFInt','FInt','DFLog','SFLog','FLog'].find(p => name.startsWith(p));
    if (known) fullName = name;
    else fullName = prefix + name;
    tEl.textContent = fullName + '  =  ' + val;
    bEl.textContent = detectKindClient(prefix).toUpperCase();
    pEl.classList.add('valid');
}
function addFlagFromForm() {
    const rawName = document.getElementById('addName').value.trim();
    const value = document.getElementById('addValue').value.trim() || 'true';
    if (!rawName) {
        toast('Enter a flag name', true);
        return;
    }
    const prefixes = ['DFString','SFString','FString','DFFlag','SFFlag','FFlag',
                      'DFInt','SFInt','FInt','DFLog','SFLog','FLog'];
    let fullName;
    const known = prefixes.find(p => rawName.startsWith(p));
    if (known) fullName = rawName;
    else fullName = detectPrefixClient(rawName, value) + rawName;
    flags[fullName] = value;
    render();
    saveLocal();
    toast('Added ' + fullName);
    document.getElementById('addName').value = '';
    document.getElementById('addValue').value = 'true';
    updateAddPreview();
}
async function loadCatalogSidebar() {
    const list = document.getElementById('catList');
    if (!list) return;
    const q = (document.getElementById('catSearch').value || '').trim();
    if (!q) {
        list.innerHTML = '<div class="no-fav">Type to search.</div>';
        return;
    }
    const res = await api.search_catalog(q);
    const results = res.results || [];
    if (!results.length) {
        list.innerHTML = '<div class="no-fav">No matches.</div>';
        return;
    }
    list.innerHTML = '';
    for (const name of results) {
        const item = document.createElement('div');
        item.className = 'catalog-item';
        item.title = name;
        item.innerHTML = '<span class="ci-name">' + escapeHtml(name) + '</span><span class="ci-plus">+</span>';
        item.onclick = () => addCatalogFlag(name);
        list.appendChild(item);
    }
}
let _catTimer = null;
function debouncedCatalog() {
    clearTimeout(_catTimer);
    _catTimer = setTimeout(loadCatalogSidebar, 160);
}
async function addCatalogFlag(name) {
    let val = flags[name];
    if (val === undefined) {
        const def = await api.get_default_value(name);
        val = (def.value !== null && def.value !== undefined) ? String(def.value) : 'true';
    }
    flags[name] = val;
    render();
    saveLocal();
    toast('Added ' + name);
}

