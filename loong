def apply_colorkey_to_topbar():
    """LWA_COLORKEY only. No frame strip. No DWM calls. No SetWindowPos.
       Legacy external topbar color-key helper; retained for compatibility."""
    global _topbar_window
    if not _topbar_window:
        return False
    hwnd = None
    try:
        hwnd = getattr(_topbar_window, "native_handle", None)
    except Exception:
        hwnd = None
    if not hwnd:
        try:
            hwnd = ctypes.windll.user32.FindWindowW(None, "Deadwae Bar")
        except Exception:
            hwnd = None
    if not hwnd:
        push("Topbar HWND not ready")
        return False
    try:
        u32 = ctypes.windll.user32
        r, g, b = hex_to_rgb_tuple(TOPBAR_KEY_COLOR)
        cr = (b << 16) | (g << 8) | r
        GWL_EXSTYLE = -20
        WS_EX_LAYERED = 0x00080000
        LWA_COLORKEY = 0x00000001
        u32.GetWindowLongW.restype = ctypes.c_long
        u32.SetWindowLongW.restype = ctypes.c_long
        u32.GetWindowLongW.argtypes = [ctypes.wintypes.HWND, ctypes.c_int]
        u32.SetWindowLongW.argtypes = [ctypes.wintypes.HWND, ctypes.c_int, ctypes.c_long]
        style = u32.GetWindowLongW(ctypes.wintypes.HWND(hwnd), GWL_EXSTYLE)
        if not (style & WS_EX_LAYERED):
            u32.SetWindowLongW(
                ctypes.wintypes.HWND(hwnd),
                GWL_EXSTYLE,
                style | WS_EX_LAYERED
            )
        u32.SetLayeredWindowAttributes(
            ctypes.wintypes.HWND(hwnd),
            cr,
            0,
            LWA_COLORKEY
        )
        push("Colorkey applied")
        return True
    except Exception as e:
        push("colorkey: " + str(e))
        return False

